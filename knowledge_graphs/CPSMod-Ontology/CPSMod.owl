<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.hsu-ifa.de/ontologies/CPSMod#"
     xml:base="http://www.hsu-ifa.de/ontologies/CPSMod"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:VDI3682="http://www.w3id.org/hsu-aut/VDI3682#"
     xmlns:VDI2206="http://www.w3id.org/hsu-aut/VDI2206#"
     xmlns:UMLStateMachine="http://www.hsu-ifa.de/ontologies/UMLStateMachine#"
     xmlns:DINEN61360="http://www.hsu-ifa.de/ontologies/DINEN61360#"
     xmlns:OpenMath="http://openmath.org/vocab/math#"
     xmlns:sosa="http://www.w3.org/ns/sosa/"
     xmlns:DIN17359="http://www.hsu-ifa.de/ontologies/DIN17359#">

    <owl:Ontology rdf:about="http://www.hsu-ifa.de/ontologies/CPSMod">
        <owl:versionIRI rdf:resource="http://www.hsu-ifa.de/ontologies/CPSMod/1.0.0"/>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <rdfs:comment xml:lang="en">CPSMod (Cyber-Physical System Model) - An alignment ontology integrating VDI 2206 (system structure), VDI 3682 (process description), DIN ISO 17359 (diagnostics), DIN EN 61360 (data elements), SOSA (sensors/actuators), OpenMath (mathematical models), and UML State Machine (behavioral models) to provide a unified system model for cyber-physical production systems.</rdfs:comment>
        <owl:imports rdf:resource="http://www.w3id.org/hsu-aut/VDI2206"/>
        <owl:imports rdf:resource="http://www.w3id.org/hsu-aut/VDI3682"/>
        <owl:imports rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359"/>
        <owl:imports rdf:resource="http://www.hsu-ifa.de/ontologies/DINEN61360"/>
        <owl:imports rdf:resource="http://openmath.org/vocab/math"/>
        <owl:imports rdf:resource="http://www.hsu-ifa.de/ontologies/UMLStateMachine"/>
        <owl:imports rdf:resource="http://www.w3.org/ns/sosa/"/>
    </owl:Ontology>
    

    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    <!-- http://www.hsu-ifa.de/ontologies/CPSMod#consistsOfBehaviorModel -->
    <owl:ObjectProperty rdf:about="http://www.hsu-ifa.de/ontologies/CPSMod#consistsOfBehaviorModel">
        <rdfs:domain rdf:resource="http://www.hsu-ifa.de/ontologies/CPSMod#SystemModel"/>
        <rdfs:range rdf:resource="http://www.w3id.org/hsu-aut/VDI2206#MathematicalModel"/>
    </owl:ObjectProperty>

    <!-- http://www.hsu-ifa.de/ontologies/CPSMod#consistsOfFunctionModel -->
    <owl:ObjectProperty rdf:about="http://www.hsu-ifa.de/ontologies/CPSMod#consistsOfFunctionModel">
        <rdfs:domain rdf:resource="http://www.hsu-ifa.de/ontologies/CPSMod#SystemModel"/>
        <rdfs:range rdf:resource="http://www.w3id.org/hsu-aut/VDI3682#Process"/>
    </owl:ObjectProperty>

    <!-- http://www.hsu-ifa.de/ontologies/CPSMod#consistsOfStructureModel -->
    <owl:ObjectProperty rdf:about="http://www.hsu-ifa.de/ontologies/CPSMod#consistsOfStructureModel">
        <rdfs:domain rdf:resource="http://www.hsu-ifa.de/ontologies/CPSMod#SystemModel"/>
        <rdfs:range rdf:resource="http://www.w3id.org/hsu-aut/VDI2206#BasicSystem"/>
    </owl:ObjectProperty>

    <!-- http://www.hsu-ifa.de/ontologies/CPSMod#consistsOfDiagnosticModel -->
    <owl:ObjectProperty rdf:about="http://www.hsu-ifa.de/ontologies/CPSMod#consistsOfDiagnosticModel">
        <rdfs:domain rdf:resource="http://www.hsu-ifa.de/ontologies/CPSMod#SystemModel"/>
        <rdfs:range rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#DiagnosticModel"/>
        <rdfs:comment xml:lang="en">
            Links a SystemModel to its diagnostic model(s). The diagnostic model describes methods 
            and relationships for condition monitoring, fault detection, and diagnosis of the system. 
        </rdfs:comment>
        <rdfs:label xml:lang="en">consists of diagnostic model</rdfs:label>
    </owl:ObjectProperty>

    <!-- http://www.hsu-ifa.de/ontologies/CPSMod#processRealizesBehavior -->
    <owl:ObjectProperty rdf:about="http://www.hsu-ifa.de/ontologies/CPSMod#processRealizesBehavior">
    <rdfs:domain>
        <owl:Class>
        <owl:unionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.w3id.org/hsu-aut/VDI3682#Process"/>
            <rdf:Description rdf:about="http://www.w3id.org/hsu-aut/VDI3682#ProcessOperator"/>
        </owl:unionOf>
        </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="http://www.w3id.org/hsu-aut/VDI2206#MathematicalModel"/>
    </owl:ObjectProperty>

    <!-- http://www.hsu-ifa.de/ontologies/CPSMod#isDataFor -->
    <owl:ObjectProperty rdf:about="http://www.hsu-ifa.de/ontologies/CPSMod#isDataFor">
    <rdfs:domain rdf:resource="http://www.hsu-ifa.de/ontologies/DINEN61360#Data_Element"/>
    <rdfs:range>
        <owl:Class>
        <owl:unionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="http://openmath.org/vocab/math#Object"/>
            <rdf:Description rdf:about="http://www.hsu-ifa.de/ontologies/UMLStateMachine#State"/>
            <rdf:Description rdf:about="http://www.hsu-ifa.de/ontologies/UMLStateMachine#Event"/>
            <rdf:Description rdf:about="http://www.hsu-ifa.de/ontologies/UMLStateMachine#Action"/>
        </owl:unionOf>
        </owl:Class>
    </rdfs:range>
    <rdfs:comment xml:lang="en">
        Links a data element to an OpenMath Object, a UML state, or a UML event.
    </rdfs:comment>
    </owl:ObjectProperty>


    <!-- http://www.hsu-ifa.de/ontologies/CPSMod#isChangedByActuator -->
    <owl:ObjectProperty rdf:about="http://www.hsu-ifa.de/ontologies/CPSMod#isChangedByActuator">
        <rdfs:domain rdf:resource="http://www.w3id.org/hsu-aut/VDI3682#State"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3id.org/hsu-aut/VDI2206#Actuator"/>
                    <rdf:Description rdf:about="http://www.w3.org/ns/sosa/Actuator"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">
            Links a system, material, energy or information state, to the actuator that causes its change.
        </rdfs:comment>
    </owl:ObjectProperty>

    <!-- http://www.hsu-ifa.de/ontologies/CPSMod#isObservedBySensor -->
    <owl:ObjectProperty rdf:about="http://www.hsu-ifa.de/ontologies/CPSMod#isObservedBySensor">
        <rdfs:domain rdf:resource="http://www.w3id.org/hsu-aut/VDI3682#State"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3id.org/hsu-aut/VDI2206#Sensor"/>
                    <rdf:Description rdf:about="http://www.w3.org/ns/sosa/Sensor"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">
            Links a system, material, energy or information state to the sensor that observes or measures it.
        </rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.hsu-ifa.de/ontologies/DINEN61360#has_Data_Element -->

    <owl:ObjectProperty rdf:about="http://www.hsu-ifa.de/ontologies/DINEN61360#has_Data_Element">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3id.org/hsu-aut/VDI2206#BasicSystem"/>
                    <rdf:Description rdf:about="http://www.w3id.org/hsu-aut/VDI3682#TechnicalResource"/>
                    <rdf:Description rdf:about="http://www.w3id.org/hsu-aut/VDI3682#State"/>
                </owl:unionOf> 
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.hsu-ifa.de/ontologies/DINEN61360#Data_Element"/>
        <rdfs:comment>Description:
This ObjectProperty is used to connect any kind of entity with a data element that is used for its description.</rdfs:comment>
    </owl:ObjectProperty>


    <owl:ObjectProperty rdf:about="http://www.hsu-ifa.de/ontologies/CPSMod#isCharacterizedByParameter">
        <rdfs:domain rdf:resource="http://www.w3id.org/hsu-aut/VDI3682#State"/>
        <rdfs:range rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#Parameter"/>
        <rdfs:comment xml:lang="en">
            Links a state (Product, Energy, or Information) to the measurement parameter(s) 
            that characterize or quantify this state. The parameter defines what measurable 
            variable is used to observe, monitor, or control the state during process execution.
        </rdfs:comment>
        <rdfs:label xml:lang="en">is characterized by parameter</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.hsu-ifa.de/ontologies/CPSMod#technicalResourceRealizes">
        <rdfs:domain rdf:resource="http://www.w3id.org/hsu-aut/VDI3682#TechnicalResource"/>
        <rdfs:range rdf:resource="http://www.w3id.org/hsu-aut/VDI3682#ProcessOperator"/>
    </owl:ObjectProperty>
    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.hsu-ifa.de/ontologies/CPSMod#SystemModel -->

    <owl:Class rdf:about="http://www.hsu-ifa.de/ontologies/CPSMod#SystemModel">
        <rdfs:comment>A model that describes different aspects of a system. For technical systems (e.g., mechatronic systems), it encompasses aspects of the cyber-physical system’s functions respectively process operators, structure, and behavior.</rdfs:comment>
    </owl:Class>



    <!-- http://www.w3id.org/hsu-aut/VDI2206#BasicSystem -->

    <owl:Class rdf:about="http://www.w3id.org/hsu-aut/VDI2206#BasicSystem">
        <owl:equivalentClass rdf:resource="http://www.w3id.org/hsu-aut/VDI3682#TechnicalResource"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/FeatureOfInterest"/>
        <rdfs:comment>The basic system is generally a mechanical, electromechanical, hydraulic or pneumatic structure or a combination of these.</rdfs:comment>
        <rdfs:label>Basic System</rdfs:label>
    </owl:Class>

     <!-- http://www.w3id.org/hsu-aut/VDI2206#MathematicalModel -->
    <owl:Class rdf:about="http://www.w3id.org/hsu-aut/VDI2206#MathematicalModel">
        <rdfs:comment>Mathematical models are used to describe the behavior of mechatronic systems.</rdfs:comment>
        <rdfs:label>Mathematical Model</rdfs:label>
    </owl:Class>

     <!-- http://www.w3id.org/hsu-aut/VDI2206#Sensor -->

    <owl:Class rdf:about="http://www.w3id.org/hsu-aut/VDI2206#Sensor">
        <owl:equivalentClass rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>	
        <rdfs:subClassOf rdf:resource="http://www.w3id.org/hsu-aut/VDI2206#Component"/>
        <rdfs:comment>The task of the sensors is to determine selected state variables of the basic system.</rdfs:comment>
    </owl:Class>

        <!-- http://www.w3id.org/hsu-aut/VDI2206#Actuator -->

    <owl:Class rdf:about="http://www.w3id.org/hsu-aut/VDI2206#Actuator">
        <owl:equivalentClass rdf:resource="http://www.w3.org/ns/sosa/Actuator"/>    
        <rdfs:subClassOf rdf:resource="http://www.w3id.org/hsu-aut/VDI2206#Component"/>
        <rdfs:comment>The information processing determines the effects necessary to influence the state variables of the basic system in the desired way. The implementation of the effects takes place by actors directly on the basic system.</rdfs:comment>
    </owl:Class>
    
 <!--VDI3682-->

 <!-- http://www.w3id.org/hsu-aut/VDI3682#Energy -->

    <owl:Class rdf:about="http://www.w3id.org/hsu-aut/VDI3682#Energy">
        <rdfs:subClassOf rdf:resource="http://www.w3id.org/hsu-aut/VDI3682#State"/>
        <rdfs:comment>Energy is requiered by the process operator to fullfill the process. Energy is Input and Output of a process. Energy can be any kind of energy, exp.: electricity, heat,...</rdfs:comment>
    </owl:Class>



    <!-- http://www.w3id.org/hsu-aut/VDI3682#Information -->

    <owl:Class rdf:about="http://www.w3id.org/hsu-aut/VDI3682#Information">
        <rdfs:subClassOf rdf:resource="http://www.w3id.org/hsu-aut/VDI3682#State"/>
        <rdfs:comment>Information input for a process operator can be any kind of information required to fullfill the process. Information output can be any kind of information created by the process.
[VDI 3682-1]</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.w3id.org/hsu-aut/VDI3682#Process -->

    <owl:Class rdf:about="http://www.w3id.org/hsu-aut/VDI3682#Process">
        <owl:disjointWith rdf:resource="http://www.w3id.org/hsu-aut/VDI3682#State"/>
        <owl:disjointWith rdf:resource="http://www.w3id.org/hsu-aut/VDI3682#SystemLimit"/>
        <owl:disjointWith rdf:resource="http://www.w3id.org/hsu-aut/VDI3682#TechnicalResource"/>
        <rdfs:comment>A process describes the desired function of a process operator, by means of a solution neutral description of inputs and outputs. Products,energies  and information are converted into new products,energies  and information by a process operator. The process operator implements this conversion with the help of technical resources.
[VDI3682-1]

Note that a process may have inputs and outputs. These are inputs / outputs that are on the system limit of this process.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.w3id.org/hsu-aut/VDI3682#ProcessOperator -->

    <owl:Class rdf:about="http://www.w3id.org/hsu-aut/VDI3682#ProcessOperator">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3id.org/hsu-aut/VDI3682#hasInput"/>
                        <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3id.org/hsu-aut/VDI3682#hasOutput"/>
                        <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty>
                            <rdf:Description>
                                <owl:inverseOf rdf:resource="http://www.w3id.org/hsu-aut/VDI3682#consistsOf"/>
                            </rdf:Description>
                        </owl:onProperty>
                        <owl:someValuesFrom rdf:resource="http://www.w3id.org/hsu-aut/VDI3682#Process"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3id.org/hsu-aut/VDI3682#hasInput"/>
                        <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3id.org/hsu-aut/VDI3682#hasOutput"/>
                        <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.w3id.org/hsu-aut/VDI3682#State"/>
        <owl:disjointWith rdf:resource="http://www.w3id.org/hsu-aut/VDI3682#SystemLimit"/>
        <owl:disjointWith rdf:resource="http://www.w3id.org/hsu-aut/VDI3682#TechnicalResource"/>
        <rdfs:comment>One step of a process that transfers a status &quot;before&quot; (i.e., an input) to a status &quot;after&quot; (i.e., an output). 
Everything that has an input and an output may be a process operator (but could also be a process).
Everything that has an input and an output AND is contained within a process is a process operator.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.w3id.org/hsu-aut/VDI3682#Product -->

    <owl:Class rdf:about="http://www.w3id.org/hsu-aut/VDI3682#Product">
        <rdfs:subClassOf rdf:resource="http://www.w3id.org/hsu-aut/VDI3682#State"/>
        <rdfs:comment>A rather generic concepts to describe all sorts of raw, intermediate or final products. Can also be used to describe flow of materials.
[VDI 3682-1]</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.w3id.org/hsu-aut/VDI3682#State -->

    <owl:Class rdf:about="http://www.w3id.org/hsu-aut/VDI3682#State">
        <owl:disjointWith rdf:resource="http://www.w3id.org/hsu-aut/VDI3682#SystemLimit"/>
        <owl:disjointWith rdf:resource="http://www.w3id.org/hsu-aut/VDI3682#TechnicalResource"/>
        <rdfs:comment>A State describes the actual state of a Product/Energy/Information. Exp.: status ante operationem and status post operationem.
[VDI3682-1]</rdfs:comment>
    </owl:Class>
    

<!--OpenMath-->

    <owl:Class rdf:about="http://openmath.org/vocab/math#Application">
        <rdfs:subClassOf rdf:resource="http://www.w3id.org/hsu-aut/VDI2206#MathematicalModel"/>
        <rdfs:label>Application</rdfs:label>
        <rdfs:comment>An application of an OM:Operator to an OM:ObjectList (the core OpenMath construct).</rdfs:comment>
    </owl:Class>

<!-- UML State Machine -->

    <owl:Class rdf:about="http://www.hsu-ifa.de/ontologies/UMLStateMachine#StateMachine">
        <rdfs:subClassOf rdf:resource="http://www.w3id.org/hsu-aut/VDI2206#MathematicalModel"/>
        <rdfs:label    xml:lang="en">State Machine</rdfs:label>
        <rdfs:comment  xml:lang="en">Abstract model defining States and Transitions.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://www.hsu-ifa.de/ontologies/UMLStateMachine#State">
            <rdfs:label    xml:lang="en">State</rdfs:label>
            <rdfs:comment  xml:lang="en">A distinct condition or situation of the system.</rdfs:comment>
     </owl:Class>

    <owl:Class rdf:about="http://www.hsu-ifa.de/ontologies/UMLStateMachine#Transition">
        <rdfs:label    xml:lang="en">Transition</rdfs:label>
        <rdfs:comment  xml:lang="en">Change from one State to another, possibly triggered by an Event.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://www.hsu-ifa.de/ontologies/UMLStateMachine#Event">
        <rdfs:label    xml:lang="en">Event</rdfs:label>
        <rdfs:comment  xml:lang="en">Occurrence that may trigger a Transition.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://www.hsu-ifa.de/ontologies/UMLStateMachine#Action">
        <rdfs:label    xml:lang="en">Action</rdfs:label>
        <rdfs:comment  xml:lang="en">An operation executed on entry, during, or exit of a State, or as effect of a Transition.</rdfs:comment>
    </owl:Class>

<!--DINEN61360 -->

<!-- http://www.hsu-ifa.de/ontologies/DINEN61360#Data_Element -->

    <owl:Class rdf:about="http://www.hsu-ifa.de/ontologies/DINEN61360#Data_Element">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.hsu-ifa.de/ontologies/DINEN61360#has_Instance_Description"/>
                        <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                        <owl:onClass>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://www.hsu-ifa.de/ontologies/DINEN61360#Instance_Description"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://www.hsu-ifa.de/ontologies/DINEN61360#Expression_Goal"/>
                                        <owl:hasValue>Actual_Value</owl:hasValue>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:onClass>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.hsu-ifa.de/ontologies/DINEN61360#has_Instance_Description"/>
                        <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                        <owl:onClass>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://www.hsu-ifa.de/ontologies/DINEN61360#Instance_Description"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://www.hsu-ifa.de/ontologies/DINEN61360#Expression_Goal"/>
                                        <owl:hasValue>Assurance</owl:hasValue>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:onClass>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.hsu-ifa.de/ontologies/DINEN61360#has_Instance_Description"/>
                        <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                        <owl:onClass>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://www.hsu-ifa.de/ontologies/DINEN61360#Instance_Description"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://www.hsu-ifa.de/ontologies/DINEN61360#Expression_Goal"/>
                                        <owl:hasValue>Requirement</owl:hasValue>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:onClass>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hsu-ifa.de/ontologies/DINEN61360#has_Type_Description"/>
                <owl:someValuesFrom rdf:resource="http://www.hsu-ifa.de/ontologies/DINEN61360#Type_Description"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.hsu-ifa.de/ontologies/DINEN61360#has_Instance_Description"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.hsu-ifa.de/ontologies/DINEN61360#Instance_Description"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.hsu-ifa.de/ontologies/DINEN61360#Type_Description"/>
        <rdfs:comment>Description:
Contains a the structure of all data element (DIN61360 3.5.2, see also section 4)

Each Data_Element has to have a type description and may have an instance description</rdfs:comment>
    </owl:Class>

<!--SOSA-->

    <owl:Class rdf:about="http://www.w3.org/ns/sosa/Sensor">
        <owl:equivalentClass rdf:resource="http://www.w3id.org/hsu-aut/VDI2206#Sensor"/>
        <rdfs:comment xml:lang="en">
            Equate SOSA Sensor with VDI2206:Sensor
        </rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://www.w3.org/ns/sosa/Actuator">
        <owl:equivalentClass rdf:resource="http://www.w3id.org/hsu-aut/VDI2206#Actuator"/>
        <rdfs:comment xml:lang="en">
            Equate SOSA Actuator with VDI2206:Actuator
        </rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://www.w3.org/ns/sosa/ObservableProperty">
        <rdfs:subClassOf rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#Parameter"/>
        <rdfs:comment xml:lang="en">
            A property that can be observed by a sensor.
            As a subclass of DIN17359:Parameter, an observable property represents a 
            measurable variable used for condition monitoring and feature extraction.
        </rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://www.w3.org/ns/sosa/ActuatableProperty">
        <rdfs:subClassOf rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#Parameter"/>
        <rdfs:comment xml:lang="en">
            A property that can be acted upon by an actuator.
            As a subclass of DIN17359:Parameter, an actuatable property represents a 
            control parameter that is actively changed to influence the system state.
        </rdfs:comment>
    </owl:Class>
    
<!--DIN17359-->


    <owl:Class rdf:about="http://www.hsu-ifa.de/ontologies/DIN17359#MeasuredData">
        <rdfs:label>Measured Data</rdfs:label>
        <rdfs:comment>Time-bounded dataset produced by the measurement system.</rdfs:comment>
    </owl:Class>

    <!-- Diagnostic models / process -->
    <owl:Class rdf:about="http://www.hsu-ifa.de/ontologies/DIN17359#DiagnosticModel">
        <rdfs:label>Diagnostic Model</rdfs:label>
        <rdfs:comment>Model (data/stat/knowledge-based) relating features to condition parameters/classes for diagnosis.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://www.hsu-ifa.de/ontologies/DIN17359#Parameter">
        <rdfs:label>Measurement Parameter</rdfs:label>
        <rdfs:comment>Measurable variable used for condition monitoring and feature extraction.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://www.hsu-ifa.de/ontologies/DIN17359#DiagnosticSubject">
        <rdfs:label>Diagnostic Subject</rdfs:label>
        <rdfs:comment>Entity whose condition is to be determined (system/machine/component/process).</rdfs:comment>
        <owl:equivalentClass rdf:resource="http://www.w3id.org/hsu-aut/VDI2206#BasicSystem"/>
    </owl:Class>

</rdf:RDF>



