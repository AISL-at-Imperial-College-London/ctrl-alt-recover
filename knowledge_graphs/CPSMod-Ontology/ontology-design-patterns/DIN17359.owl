<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
  xmlns:rdf ="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xmlns:owl ="http://www.w3.org/2002/07/owl#"
  xmlns:xsd ="http://www.w3.org/2001/XMLSchema#"
  xmlns:DIN17359="http://www.hsu-ifa.de/ontologies/DIN17359#">

  <!-- Ontology -->
  <owl:Ontology rdf:about="http://www.hsu-ifa.de/ontologies/DIN17359">
    <rdfs:label>DIN ISO 17359 – Diagnostics ODP (RDF/XML)</rdfs:label>
    <rdfs:comment>ODP for condition information, causes, symptoms, faults, and diagnostic models, aligned with DIN ISO 17359.</rdfs:comment>
  </owl:Ontology>

  <!-- ======== CLASSES ======== -->
  <owl:Class rdf:about="http://www.hsu-ifa.de/ontologies/DIN17359#Feature">
    <rdfs:label>Feature</rdfs:label>
    <rdfs:comment>Signal characteristic derived from measured data; used to quantify symptoms and feed diagnostic models.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://www.hsu-ifa.de/ontologies/DIN17359#FeatureInstance">
      <rdfs:label>Feature Instance</rdfs:label>
      <rdfs:comment>Concrete computed feature observation with actual value, produced during a diagnostic run.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://www.hsu-ifa.de/ontologies/DIN17359#ReferenceValue">
    <rdfs:label>Reference Value</rdfs:label>
    <rdfs:comment>Baseline/limit used to assess features under reference conditions.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://www.hsu-ifa.de/ontologies/DIN17359#Anomaly">
    <rdfs:label>Anomaly</rdfs:label>
    <rdfs:comment>Detected deviation from expected behaviour/condition.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://www.hsu-ifa.de/ontologies/DIN17359#Symptom">
    <rdfs:label>Symptom</rdfs:label>
    <rdfs:comment>Observable phenomenon indicating a fault; quantified by features.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://www.hsu-ifa.de/ontologies/DIN17359#Fault">
    <rdfs:label>Fault (defect)</rdfs:label>
    <rdfs:comment>Operational condition deviating beyond tolerance; a state (not an event).</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://www.hsu-ifa.de/ontologies/DIN17359#DiagnosticSubject">
    <rdfs:label>Diagnostic Subject</rdfs:label>
    <rdfs:comment>Entity whose condition is to be determined (system/machine/component/process).</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://www.hsu-ifa.de/ontologies/DIN17359#Parameter">
    <rdfs:label>Measurement Parameter</rdfs:label>
    <rdfs:comment>Measurable variable used for condition monitoring and feature extraction.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://www.hsu-ifa.de/ontologies/DIN17359#MeasuredData">
    <rdfs:label>Measured Data</rdfs:label>
    <rdfs:comment>Time-bounded dataset produced by the measurement system.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://www.hsu-ifa.de/ontologies/DIN17359#Cause">
    <rdfs:label>Cause</rdfs:label>
    <rdfs:comment>Operating condition, environmental influence or action that leads to a fault.</rdfs:comment>
  </owl:Class>

  <!-- Diagnostic models / process -->
  <owl:Class rdf:about="http://www.hsu-ifa.de/ontologies/DIN17359#DiagnosticModel">
    <rdfs:label>Diagnostic Model</rdfs:label>
    <rdfs:comment>Model (data/stat/knowledge-based) relating features classes for diagnosis.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://www.hsu-ifa.de/ontologies/DIN17359#Diagnostics">
    <rdfs:label>Diagnostics</rdfs:label>
    <rdfs:comment>Diagnostic process execution and its outcome (diagnosis).</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://www.hsu-ifa.de/ontologies/DIN17359#DataBasedDiagnosticModel">
    <rdfs:label>Data-Based Diagnostic Model</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#DiagnosticModel"/>
  </owl:Class>

  <owl:Class rdf:about="http://www.hsu-ifa.de/ontologies/DIN17359#StatisticalDiagnosticModel">
    <rdfs:label>Statistical Diagnostic Model</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#DiagnosticModel"/>
  </owl:Class>

  <owl:Class rdf:about="http://www.hsu-ifa.de/ontologies/DIN17359#KnowledgeBasedDiagnosticModel">
    <rdfs:label>Knowledge-Based Diagnostic Model</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#DiagnosticModel"/>
  </owl:Class>


  <!-- ======== OBJECT PROPERTIES ======== -->

  <!-- Measurement & features -->
  <owl:ObjectProperty rdf:about="http://www.hsu-ifa.de/ontologies/DIN17359#isObservedBy">
      <rdfs:label>isObservedBy</rdfs:label>
      <rdfs:comment>Links a diagnostic subject to its observable parameters.</rdfs:comment>
      <rdfs:domain rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#DiagnosticSubject"/>
      <rdfs:range  rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#Parameter"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.hsu-ifa.de/ontologies/DIN17359#hasFeatureInstance">
      <rdfs:label>hasFeatureInstance</rdfs:label>
      <rdfs:comment>Links a static feature definition to a dynamically computed feature instance.</rdfs:comment>
      <rdfs:domain rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#Feature"/>
      <rdfs:range  rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#FeatureInstance"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.hsu-ifa.de/ontologies/DIN17359#hasDerivedFeature">
      <rdfs:label>hasDerivedFeature</rdfs:label>
      <rdfs:comment>Links a measured dataset to features derived from it.</rdfs:comment>
      <rdfs:domain rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#MeasuredData"/>
      <rdfs:range  rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#FeatureInstance"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.hsu-ifa.de/ontologies/DIN17359#FeatureIsComparedTo">
    <rdfs:label>FeaturesIsComparedTo</rdfs:label>
    <rdfs:domain rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#Feature"/>
    <rdfs:range  rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#ReferenceValue"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.hsu-ifa.de/ontologies/DIN17359#ParameterIsDescribedByFeature">
    <rdfs:label>ParameterIsDescribedByFeature</rdfs:label>
    <rdfs:domain rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#Parameter"/>
    <rdfs:range  rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#Feature"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.hsu-ifa.de/ontologies/DIN17359#FeatureConsistsOfFeature">
      <rdfs:label xml:lang="en">FeatureConsistsOfFeature</rdfs:label>
      <rdfs:comment xml:lang="en">Links a derived/combined feature to its constituent features. Used when a diagnostic feature is computed from multiple underlying features (e.g., saturation feature combining actuator position and control error).</rdfs:comment>
      <rdfs:domain rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#Feature"/>
      <rdfs:range rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#Feature"/>
  </owl:ObjectProperty>

  <!-- Symptom / anomaly relations -->
  <owl:ObjectProperty rdf:about="http://www.hsu-ifa.de/ontologies/DIN17359#FeatureIndicatesAnomaly">
    <rdfs:label>FeatureIndicatesAnomaly</rdfs:label>
    <rdfs:domain rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#FeatureInstance"/>
    <rdfs:range  rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#Anomaly"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.hsu-ifa.de/ontologies/DIN17359#SymptomIsExtractedFromFeature">
    <rdfs:label>SymptomIsExtractedFromFeature</rdfs:label>
    <rdfs:domain rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#Symptom"/>
    <rdfs:range  rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#Feature"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.hsu-ifa.de/ontologies/DIN17359#SymptomDescribesAnomaly">
    <rdfs:label>SymptomDescribesAnomaly</rdfs:label>
    <rdfs:domain rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#Symptom"/>
    <rdfs:range  rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#Anomaly"/>
  </owl:ObjectProperty>

  <!-- Diagnostics inputs/outputs -->
  <owl:ObjectProperty rdf:about="http://www.hsu-ifa.de/ontologies/DIN17359#hasInputAnomaly">
    <rdfs:label>hasInputAnomaly</rdfs:label>
    <rdfs:domain rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#Diagnostics"/>
    <rdfs:range  rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#Anomaly"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.hsu-ifa.de/ontologies/DIN17359#hasInputFeature">
    <rdfs:label>hasInputFeature</rdfs:label>
    <rdfs:domain rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#Diagnostics"/>
    <rdfs:range  rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#FeatureInstance"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.hsu-ifa.de/ontologies/DIN17359#hasInputSymptom">
    <rdfs:label>hasInputSymptom</rdfs:label>
    <rdfs:domain rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#Diagnostics"/>
    <rdfs:range  rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#Symptom"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.hsu-ifa.de/ontologies/DIN17359#DiagnosticsModelIsAssignedTo">
    <rdfs:label>DiagnosticsModelIsAssignedTo</rdfs:label>
    <rdfs:domain rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#DiagnosticModel"/>
    <rdfs:range  rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#Diagnostics"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.hsu-ifa.de/ontologies/DIN17359#hasInputSubject">
    <rdfs:label>hasInputSubject</rdfs:label>
    <rdfs:domain rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#Diagnostics"/>
    <rdfs:range  rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#DiagnosticSubject"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.hsu-ifa.de/ontologies/DIN17359#hasOutputFault">
    <rdfs:label>hasOutputFault</rdfs:label>
    <rdfs:domain rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#Diagnostics"/>
    <rdfs:range  rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#Fault"/>
  </owl:ObjectProperty>

  <!-- Fault semantics -->
  <owl:ObjectProperty rdf:about="http://www.hsu-ifa.de/ontologies/DIN17359#FaultIsDescribedBySymptom">
    <rdfs:label>FaultIsDescribedBySymptom</rdfs:label>
    <rdfs:domain rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#Fault"/>
    <rdfs:range  rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#Symptom"/>
    <owl:inverseOf rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#SymptomIndicatesFault"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.hsu-ifa.de/ontologies/DIN17359#SymptomIndicatesFault">
    <rdfs:label>SymptomIndicatesFault</rdfs:label>  
    <rdfs:domain rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#Symptom"/>
    <rdfs:range  rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#Fault"/>
    <owl:inverseOf rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#FaultIsDescribedBySymptom"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.hsu-ifa.de/ontologies/DIN17359#CausesFault">
    <rdfs:label>CausesFault</rdfs:label>
    <rdfs:domain rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#Cause"/>
    <rdfs:range  rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#Fault"/>
  </owl:ObjectProperty>


  <!-- ======== DATA PROPERTIES ======== -->
  <owl:DatatypeProperty rdf:about="http://www.hsu-ifa.de/ontologies/DIN17359#startTime">
    <rdfs:label>startTime</rdfs:label>
    <rdfs:domain rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#MeasuredData"/>
    <rdfs:range  rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://www.hsu-ifa.de/ontologies/DIN17359#endTime">
    <rdfs:label>endTime</rdfs:label>
    <rdfs:domain rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#MeasuredData"/>
    <rdfs:range  rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://www.hsu-ifa.de/ontologies/DIN17359#samplingRate">
    <rdfs:label>samplingRate</rdfs:label>
    <rdfs:domain rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#MeasuredData"/>
    <rdfs:range  rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://www.hsu-ifa.de/ontologies/DIN17359#featureValue">
    <rdfs:label>featureValue</rdfs:label>
    <rdfs:domain rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#FeatureInstance"/>
    <rdfs:range  rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://www.hsu-ifa.de/ontologies/DIN17359#featureUnit">
    <rdfs:label>featureUnit</rdfs:label>
    <rdfs:domain rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#Feature"/>
    <rdfs:range  rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://www.hsu-ifa.de/ontologies/DIN17359#featureComputedAt">
    <rdfs:label>featureComputedAt</rdfs:label>
    <rdfs:domain rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#FeatureInstance"/>
    <rdfs:range  rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://www.hsu-ifa.de/ontologies/DIN17359#referenceValue">
    <rdfs:label>referenceValue</rdfs:label>
    <rdfs:domain rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#ReferenceValue"/>
    <rdfs:range  rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://www.hsu-ifa.de/ontologies/DIN17359#referenceUnit">
    <rdfs:label>referenceUnit</rdfs:label>
    <rdfs:domain rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#ReferenceValue"/>
    <rdfs:range  rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://www.hsu-ifa.de/ontologies/DIN17359#referenceConditions">
    <rdfs:label>referenceConditions</rdfs:label>
    <rdfs:domain rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#ReferenceValue"/>
    <rdfs:range  rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://www.hsu-ifa.de/ontologies/DIN17359#parameterUnit">
    <rdfs:label>parameterUnit</rdfs:label>
    <rdfs:domain rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#Parameter"/>
    <rdfs:range  rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://www.hsu-ifa.de/ontologies/DIN17359#sensorId">
    <rdfs:label>sensorId</rdfs:label>
    <rdfs:domain rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#Parameter"/>
    <rdfs:range  rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://www.hsu-ifa.de/ontologies/DIN17359#actuatorID">
    <rdfs:label>actuatorID</rdfs:label>
    <rdfs:domain rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#Parameter"/>
    <rdfs:range  rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://www.hsu-ifa.de/ontologies/DIN17359#anomalyConfidence">
    <rdfs:label>anomalyConfidence</rdfs:label>
    <rdfs:domain rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#Anomaly"/>
    <rdfs:range  rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://www.hsu-ifa.de/ontologies/DIN17359#anomalySeverityLevel">
    <rdfs:label>anomalySeverityLevel</rdfs:label>
    <rdfs:domain rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#Anomaly"/>
    <rdfs:range  rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://www.hsu-ifa.de/ontologies/DIN17359#anomalyScore">
    <rdfs:label>anomalyScore</rdfs:label>
    <rdfs:domain rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#Anomaly"/>
    <rdfs:range  rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://www.hsu-ifa.de/ontologies/DIN17359#detectedAt">
    <rdfs:label>detectedAt</rdfs:label>
    <rdfs:domain rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#Anomaly"/>
    <rdfs:range  rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://www.hsu-ifa.de/ontologies/DIN17359#anomalyStartTime">
    <rdfs:label>anomalyStartTime</rdfs:label>
    <rdfs:domain rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#Anomaly"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://www.hsu-ifa.de/ontologies/DIN17359#anomalyEndTime">
    <rdfs:label>anomalyEndTime</rdfs:label>
    <rdfs:domain rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#Anomaly"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://www.hsu-ifa.de/ontologies/DIN17359#modelVersion">
    <rdfs:label>modelVersion</rdfs:label>
    <rdfs:domain rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#DiagnosticModel"/>
    <rdfs:range  rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://www.hsu-ifa.de/ontologies/DIN17359#diagnosisTime">
    <rdfs:label>diagnosisTime</rdfs:label>
    <rdfs:domain rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#Diagnostics"/>
    <rdfs:range  rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://www.hsu-ifa.de/ontologies/DIN17359#diagnosticsConfidence">
      <rdfs:label>diagnosticsConfidence</rdfs:label>
      <rdfs:comment>Confidence score of the diagnostic result, e.g. probability assigned by a classifier or rule-based system.</rdfs:comment>
      <rdfs:domain rdf:resource="http://www.hsu-ifa.de/ontologies/DIN17359#Diagnostics"/>
      <rdfs:range  rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>

</rdf:RDF>
