# :state_NORMAL rdfs:label "NORMAL Phase"@en .
# :state_NORMAL rdfs:comment "Continuous operation..."@en .
#
# :state_SHUTDOWN rdf:type UML:State .
# :state_FAULT rdf:type UML:State .
#
# Transitions:
# :transition_startup_normal rdf:type UML:Transition .
# :transition_startup_normal UML:source :state_STARTUP .
# :transition_startup_normal UML:target :state_NORMAL .
# :transition_startup_normal UML:transitionGuard "(L >= L_sp) OR (t >= 1000.0)" .
#
# :transition_normal_shutdown rdf:type UML:Transition .
# :transition_normal_shutdown UML:source :state_NORMAL .
# :transition_normal_shutdown UML:target :state_SHUTDOWN .
# :transition_normal_shutdown UML:transitionGuard "t >= T_startup + T_normal" .
#
# :transition_normal_fault rdf:type UML:Transition .
# :transition_normal_fault UML:source :state_NORMAL .
# :transition_normal_fault UML:target :state_FAULT .
# :transition_normal_fault UML:transitionGuard "fault_detected == True" .
#
# ============================================================================
