                    "http://www.hsu-ifa.de/ontologies/DIN17359#Feature"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Normalized concentration sequence for species A (reactant). Derived from state x[1] in mol/L."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "Feature: Concentration A"
                    }
                ]
            },
