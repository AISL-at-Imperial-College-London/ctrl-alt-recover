                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#FeatureIsComparedTo": [
                    {
                        "@id": "http://example.org/cstr#ref_Fout_nominal"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#feat_Fc",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#Feature"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Normalized cooling water flow rate sequence through heat exchanger. Source: cool_valve_in.flow()."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "Feature: Cooling Flow"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#IsUsedToIdentifySymptom": [
                    {
                        "@id": "http://example.org/cstr#symptom_Fc_high"
                    },
                    {
                        "@id": "http://example.org/cstr#symptom_Fc_low"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#feat_u_valve",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#Feature"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Normalized inlet valve position sequence in range [0-1]. Controlled by level controller during NORMAL phase. Source: valve_in.opening."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "Feature: Inlet Valve Opening"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#FeatureIsComparedTo": [
                    {
                        "@id": "http://example.org/cstr#ref_u_valve_nominal"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#feat_u_pump",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#Feature"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Normalized outlet pump speed sequence in range [0-1]. Controlled by level controller. Source: pump_out.speed."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "Feature: Outlet Pump Speed"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#FeatureIsComparedTo": [
                    {
                        "@id": "http://example.org/cstr#ref_u_pump_nominal"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#feat_u_cool",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#Feature"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Normalized cooling valve position sequence in range [0-1]. Controlled by temperature controller. Source: cool_valve_in.opening."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "Feature: Cooling Valve Opening"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#FeatureIsComparedTo": [
                    {
                        "@id": "http://example.org/cstr#ref_u_cool_nominal"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#feat_T_error",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#Feature"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Control deviation feature: difference between measured temperature (obs_param_T) and setpoint (ref_T_sp). Positive = too hot, negative = too cold."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "Temperature Error (T_error)"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#IsUsedToIdentifySymptom": [
                    {
                        "@id": "http://example.org/cstr#symptom_T_high"
                    },
                    {
                        "@id": "http://example.org/cstr#symptom_T_low"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#FeatureIsComparedTo": [
                    {
                        "@id": "http://example.org/cstr#ref_T_sp"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#feat_L_error",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#Feature"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Control deviation feature: difference between measured level (obs_param_L) and setpoint (ref_L_sp). Positive = overfilled, negative = underfilled."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "Level Error (L_error)"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#IsUsedToIdentifySymptom": [
                    {
                        "@id": "http://example.org/cstr#symptom_L_high"
                    },
                    {
                        "@id": "http://example.org/cstr#symptom_L_low"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#FeatureIsComparedTo": [
                    {
                        "@id": "http://example.org/cstr#ref_L_sp"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#feat_mass_balance",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#Feature"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Normalized mass balance indicator sequence. Computed as Fin - Fout. Non-zero values indicate leak, blockage, or accumulation."
                    },
                    {
                        "@language": "en",
                        "@value": "Feature: deviation from mass balance. Should be zero in steady state. Non-zero indicates leak, blockage or stuck valve."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "Feature: Mass Balance"
                    },
                    {
                        "@language": "en",
                        "@value": "Mass Balance Error (Fin - Fout)"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#FeatureIsComparedTo": [
                    {
                        "@id": "http://example.org/cstr#ref_mass_balance_zero"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#feat_dT_dt",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#Feature"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Normalized rate of temperature change sequence. Computed from energy balance ODE in cstr_rhs() function."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "Feature: Temperature Derivative"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#IsUsedToIdentifySymptom": [
                    {
                        "@id": "http://example.org/cstr#symptom_T_high"
                    },
                    {
                        "@id": "http://example.org/cstr#symptom_T_low"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#feat_dL_dt",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#Feature"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Normalized rate of level change sequence. Computed as dL/dt = (Fin - Fout - F_leak) / A_cs."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "Feature: Level Derivative"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#IsUsedToIdentifySymptom": [
                    {
                        "@id": "http://example.org/cstr#symptom_L_high"
                    },
                    {
                        "@id": "http://example.org/cstr#symptom_L_low"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#feat_dCA_dt",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#Feature"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Normalized rate of concentration A change sequence. Computed from material balance with reaction kinetics in cstr_rhs()."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "Feature: CA Derivative"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#feat_dCB_dt",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#Feature"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Normalized rate of concentration B change sequence. Computed from material balance with reaction kinetics in cstr_rhs()."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "Feature: CB Derivative"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#ref_T_sp",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#ReferenceValue"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Target reactor temperature for optimal reaction conversion. Value: 310 K. Used by temperature controller during NORMAL phase."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "Temperature Setpoint"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#referenceValue": [
                    {
                        "@value": "3.1E2",
                        "@type": "http://www.w3.org/2001/XMLSchema#double"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#referenceUnit": [
                    {
                        "@value": "K"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#referenceConditions": [
                    {
                        "@language": "en",
                        "@value": "Normal operation phase"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#IsUsedToIdentifySymptom": [
                    {
                        "@id": "http://example.org/cstr#symptom_T_high"
                    },
                    {
                        "@id": "http://example.org/cstr#symptom_T_low"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#ref_L_sp",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#ReferenceValue"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Target reactor liquid level for adequate residence time. Value: 10 L. Controlled via inlet valve and outlet pump coordination."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "Level Setpoint"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#referenceValue": [
                    {
                        "@value": "1.0E1",
                        "@type": "http://www.w3.org/2001/XMLSchema#double"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#referenceUnit": [
                    {
                        "@value": "L"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#referenceConditions": [
                    {
                        "@language": "en",
                        "@value": "Normal operation after startup complete"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#IsUsedToIdentifySymptom": [
                    {
                        "@id": "http://example.org/cstr#symptom_L_high"
                    },
                    {
                        "@id": "http://example.org/cstr#symptom_L_low"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#ref_Fin_sp",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#ReferenceValue"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Target inlet volumetric flow rate at steady state. Value: 2 L/min = 0.0333 L/s. Determines production throughput."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "Inlet Flow Setpoint"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#referenceValue": [
                    {
                        "@value": "3.33E-2",
                        "@type": "http://www.w3.org/2001/XMLSchema#double"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#referenceUnit": [
                    {
                        "@value": "L/s"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#referenceConditions": [
                    {
                        "@language": "en",
                        "@value": "Steady state normal operation"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#IsUsedToIdentifySymptom": [
                    {
                        "@id": "http://example.org/cstr#symptom_Fin_high"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#ref_mass_balance_zero",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#ReferenceValue"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Expected mass balance at steady state where Fin equals Fout. Value: 0 L/s. Non-zero indicates leak, blockage, or transient."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "Mass Balance Nominal"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#referenceValue": [
                    {
                        "@value": "0.0E0",
                        "@type": "http://www.w3.org/2001/XMLSchema#double"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#referenceUnit": [
                    {
                        "@value": "L/s"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#referenceConditions": [
                    {
                        "@language": "en",
                        "@value": "Steady state with no leak or accumulation"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#IsUsedToIdentifySymptom": [
                    {
                        "@id": "http://example.org/cstr#symptom_mass_imbalance"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#ref_u_valve_nominal",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#ReferenceValue"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Typical inlet valve opening at steady state operating point. Value: approximately 0.55 (55% open)."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "Inlet Valve Nominal Position"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#referenceValue": [
                    {
                        "@value": "5.5E-1",
                        "@type": "http://www.w3.org/2001/XMLSchema#double"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#referenceUnit": [
                    {
                        "@value": "-"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#referenceConditions": [
                    {
                        "@language": "en",
                        "@value": "Steady state at L_sp = 10 L"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#ref_u_pump_nominal",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#ReferenceValue"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Typical outlet pump speed at steady state operating point. Value: approximately 0.42 (42% speed)."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "Pump Nominal Speed"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#referenceValue": [
                    {
                        "@value": "4.2E-1",
                        "@type": "http://www.w3.org/2001/XMLSchema#double"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#referenceUnit": [
                    {
                        "@value": "-"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#referenceConditions": [
                    {
                        "@language": "en",
                        "@value": "Steady state at L_sp = 10 L"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#IsUsedToIdentifySymptom": [
                    {
                        "@id": "http://example.org/cstr#symptom_u_pump_saturation"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#ref_u_cool_nominal",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#ReferenceValue"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Typical cooling valve opening at steady state operating point. Value: approximately 0.30 (30% open)."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "Cooling Valve Nominal Position"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#referenceValue": [
                    {
                        "@value": "3.0E-1",
                        "@type": "http://www.w3.org/2001/XMLSchema#double"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#referenceUnit": [
                    {
                        "@value": "-"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#referenceConditions": [
                    {
                        "@language": "en",
                        "@value": "Steady state at T_sp = 310 K"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#IsUsedToIdentifySymptom": [
                    {
                        "@id": "http://example.org/cstr#symptom_u_cool_sat_high"
                    },
                    {
                        "@id": "http://example.org/cstr#symptom_u_cool_sat_low"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#symptom_T_high",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#Symptom"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Reactor temperature significantly exceeds setpoint of 310 K. Indicates insufficient cooling capacity due to heat exchanger fouling or cooling valve failure in closed position."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "S1: Temperature High"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#SymptomIsExtractedFromFeature": [
                    {
                        "@id": "http://example.org/cstr#feat_T_error"
                    },
                    {
                        "@id": "http://example.org/cstr#feat_dT_dt"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#SymptomDescribesFault": [
                    {
                        "@id": "http://example.org/cstr#fault_fouling"
                    },
                    {
                        "@id": "http://example.org/cstr#fault_cool_stuck_closed"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#symptom_T_low",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#Symptom"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Reactor temperature significantly below setpoint of 310 K. Indicates excessive cooling due to cooling valve stuck in open position."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "S3: Temperature Low"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#SymptomIsExtractedFromFeature": [
                    {
                        "@id": "http://example.org/cstr#feat_T_error"
                    },
                    {
                        "@id": "http://example.org/cstr#feat_dT_dt"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#SymptomDescribesFault": [
                    {
                        "@id": "http://example.org/cstr#fault_cool_stuck_open"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#symptom_L_high",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#Symptom"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Reactor level significantly exceeds setpoint of 10 L. Indicates outlet flow restriction from pump degradation, pipe blockage, or uncontrolled inlet flow."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "S4: Level High"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#SymptomIsExtractedFromFeature": [
                    {
                        "@id": "http://example.org/cstr#feat_L_error"
                    },
                    {
                        "@id": "http://example.org/cstr#feat_dL_dt"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#SymptomDescribesFault": [
                    {
                        "@id": "http://example.org/cstr#fault_pump_degrade"
                    },
                    {
                        "@id": "http://example.org/cstr#fault_outlet_block"
                    },
                    {
                        "@id": "http://example.org/cstr#fault_inlet_stuck_open"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#symptom_L_low",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#Symptom"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Reactor level significantly below setpoint of 10 L. Indicates material loss through tank leakage."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "S6: Level Low"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#SymptomIsExtractedFromFeature": [
                    {
                        "@id": "http://example.org/cstr#feat_L_error"
                    },
                    {
                        "@id": "http://example.org/cstr#feat_dL_dt"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#SymptomDescribesFault": [
                    {
                        "@id": "http://example.org/cstr#fault_leak"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#symptom_Fin_high",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#Symptom"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Inlet flow rate uncontrollably high regardless of valve command. Indicates inlet valve mechanically stuck in open position."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "S7: Inlet Flow High"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#SymptomIsExtractedFromFeature": [
                    {
                        "@id": "http://example.org/cstr#feat_Fin"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#SymptomDescribesFault": [
                    {
                        "@id": "http://example.org/cstr#fault_inlet_stuck_open"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#symptom_Fout_low",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#Symptom"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Outlet flow rate reduced despite pump running at commanded speed. Indicates pump mechanical degradation or outlet pipe partial blockage."
                    },
                    {
                        "@language": "en",
                        "@value": "Outlet flow significantly below expected value. Indicates pump degradation or outlet blockage."
                    },
                    {
                        "@language": "en",
                        "@value": "Outlet flow significantly below expected value."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "S5: Outlet Flow Low"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#SymptomIsExtractedFromFeature": [
                    {
                        "@id": "http://example.org/cstr#feat_Fout"
                    },
                    {
                        "@id": "http://example.org/cstr#feat_mass_balance"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#SymptomDescribesFault": [
                    {
                        "@id": "http://example.org/cstr#fault_pump_degrade"
                    },
                    {
                        "@id": "http://example.org/cstr#fault_outlet_block"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#symptom_Fc_high",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#Symptom"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Cooling water flow rate high despite low valve command. Indicates cooling valve mechanically stuck in open position."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "S3b: Cooling Flow High"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#SymptomIsExtractedFromFeature": [
                    {
                        "@id": "http://example.org/cstr#feat_Fc"
                    },
                    {
                        "@id": "http://example.org/cstr#feat_u_cool"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#SymptomDescribesFault": [
                    {
                        "@id": "http://example.org/cstr#fault_cool_stuck_open"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#symptom_Fc_low",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#Symptom"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "No cooling water flow despite valve open command. Indicates cooling valve mechanically stuck in closed position."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "S2b: Cooling Flow Low"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#SymptomIsExtractedFromFeature": [
                    {
                        "@id": "http://example.org/cstr#feat_Fc"
                    },
                    {
                        "@id": "http://example.org/cstr#feat_u_cool"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#SymptomDescribesFault": [
                    {
                        "@id": "http://example.org/cstr#fault_cool_stuck_closed"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#symptom_T_sensor_bias",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#Symptom"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Systematic deviation between true reactor temperature and measured value. Indicates temperature sensor calibration drift or failure."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "S8: Temperature Sensor Bias"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#SymptomIsExtractedFromFeature": [
                    {
                        "@id": "http://example.org/cstr#feat_T_error"
                    },
                    {
                        "@id": "http://example.org/cstr#feat_dT_dt"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#SymptomDescribesFault": [
                    {
                        "@id": "http://example.org/cstr#fault_temp_bias"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#symptom_L_sensor_bias",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#Symptom"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Systematic deviation between true reactor level and measured value. Indicates level sensor calibration drift or failure."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "S9: Level Sensor Bias"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#SymptomIsExtractedFromFeature": [
                    {
                        "@id": "http://example.org/cstr#feat_L_error"
                    },
                    {
                        "@id": "http://example.org/cstr#feat_dL_dt"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#SymptomDescribesFault": [
                    {
                        "@id": "http://example.org/cstr#fault_level_bias"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#symptom_mass_imbalance",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#Symptom"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Sustained difference between inlet and outlet flow rates. Positive indicates accumulation from outlet restriction. Negative indicates material loss from leakage."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "S10: Mass Imbalance"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#SymptomIsExtractedFromFeature": [
                    {
                        "@id": "http://example.org/cstr#feat_mass_balance"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#SymptomDescribesFault": [
                    {
                        "@id": "http://example.org/cstr#fault_outlet_block"
                    },
                    {
                        "@id": "http://example.org/cstr#fault_inlet_stuck_open"
                    },
                    {
                        "@id": "http://example.org/cstr#fault_leak"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#symptom_u_cool_sat_high",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#Symptom"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Cooling valve controller output at maximum (u_cool approaching 1.0) but temperature still rising. Indicates cooling capacity insufficient for heat load."
                    },
                    {
                        "@language": "en",
                        "@value": "Cooling valve fully open but temperature still above setpoint. Indicates fouling or insufficient cooling capacity."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "S11: Cooling Valve Saturated Open"
                    },
                    {
                        "@language": "en",
                        "@value": "S7a: Cooling Valve Saturated High"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#SymptomIsExtractedFromFeature": [
                    {
                        "@id": "http://example.org/cstr#feat_u_cool"
                    },
                    {
                        "@id": "http://example.org/cstr#feat_u_cool_saturation"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#SymptomDescribesFault": [
                    {
                        "@id": "http://example.org/cstr#fault_fouling"
                    },
                    {
                        "@id": "http://example.org/cstr#fault_cool_stuck_open"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#symptom_u_cool_sat_low",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#Symptom"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Cooling valve controller output at minimum (u_cool approaching 0.0) but temperature still falling. Indicates unwanted cooling flow."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "S12: Cooling Valve Saturated Closed"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#SymptomIsExtractedFromFeature": [
                    {
                        "@id": "http://example.org/cstr#feat_u_cool"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#SymptomDescribesFault": [
                    {
                        "@id": "http://example.org/cstr#fault_cool_stuck_closed"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#symptom_u_pump_saturation",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#Symptom"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Outlet pump controller output at maximum (u_pump approaching 1.0) but level still rising. Indicates pump cannot deliver required flow rate."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "S13: Pump Saturated"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#SymptomIsExtractedFromFeature": [
                    {
                        "@id": "http://example.org/cstr#feat_u_pump"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#SymptomDescribesFault": [
                    {
                        "@id": "http://example.org/cstr#fault_pump_degrade"
                    },
                    {
                        "@id": "http://example.org/cstr#fault_outlet_block"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#fault_fouling",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#Fault"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Heat exchanger fouling causing progressive reduction of overall heat transfer coefficient UA. Modeled as exponential degradation with time constant tau=1500s and maximum reduction of 60%. Affects cooling capacity."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "Fouling"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#FaultIsDescribedBySymptom": [
                    {
                        "@id": "http://example.org/cstr#symptom_T_high"
                    },
                    {
                        "@id": "http://example.org/cstr#symptom_u_cool_sat_high"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#fault_cool_stuck_open",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#Fault"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Cooling valve mechanically stuck in fully open position regardless of control signal. Results in maximum cooling flow and reactor temperature dropping below setpoint."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "CoolStuckOpen"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#FaultIsDescribedBySymptom": [
                    {
                        "@id": "http://example.org/cstr#symptom_T_low"
                    },
                    {
                        "@id": "http://example.org/cstr#symptom_Fc_high"
                    },
                    {
                        "@id": "http://example.org/cstr#symptom_u_cool_sat_high"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#fault_cool_stuck_closed",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#Fault"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Cooling valve mechanically stuck in fully closed position regardless of control signal. Results in zero cooling flow and reactor temperature rising above setpoint."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "CoolStuckClosed"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#FaultIsDescribedBySymptom": [
                    {
                        "@id": "http://example.org/cstr#symptom_T_high"
                    },
                    {
                        "@id": "http://example.org/cstr#symptom_Fc_low"
                    },
                    {
                        "@id": "http://example.org/cstr#symptom_u_cool_sat_low"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#fault_pump_degrade",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#Fault"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Outlet pump mechanical degradation reducing maximum flow capacity to 50% of nominal. Caused by impeller wear, seal leakage, or motor degradation. Results in inability to maintain level setpoint."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "PumpDegrade"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#FaultIsDescribedBySymptom": [
                    {
                        "@id": "http://example.org/cstr#symptom_L_high"
                    },
                    {
                        "@id": "http://example.org/cstr#symptom_Fout_low"
                    },
                    {
                        "@id": "http://example.org/cstr#symptom_u_pump_saturation"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#fault_outlet_block",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#Fault"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Partial blockage of outlet piping reducing effective flow area to 30% of nominal. Caused by precipitate buildup, foreign object, or valve malfunction. Results in reduced outlet flow and rising level."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "OutletBlock"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#FaultIsDescribedBySymptom": [
                    {
                        "@id": "http://example.org/cstr#symptom_L_high"
                    },
                    {
                        "@id": "http://example.org/cstr#symptom_Fout_low"
                    },
                    {
                        "@id": "http://example.org/cstr#symptom_mass_imbalance"
                    },
                    {
                        "@id": "http://example.org/cstr#symptom_u_pump_saturation"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#fault_inlet_stuck_open",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#Fault"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Inlet valve mechanically stuck in fully open position regardless of control signal. Results in maximum uncontrolled inlet flow and rapidly rising reactor level."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "InletStuckOpen"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#FaultIsDescribedBySymptom": [
                    {
                        "@id": "http://example.org/cstr#symptom_L_high"
                    },
                    {
                        "@id": "http://example.org/cstr#symptom_Fin_high"
                    },
                    {
                        "@id": "http://example.org/cstr#symptom_mass_imbalance"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#fault_temp_bias",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#Fault"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Temperature sensor systematic measurement bias of ±5 K. Caused by sensor drift, calibration error, or thermowell fouling. Results in incorrect temperature control."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "TempBias"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#FaultIsDescribedBySymptom": [
                    {
                        "@id": "http://example.org/cstr#symptom_T_sensor_bias"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#fault_level_bias",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#Fault"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Level sensor systematic measurement bias of ±1 L. Caused by sensor drift, calibration error, or reference leg issues. Results in incorrect level control."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "LevelBias"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#FaultIsDescribedBySymptom": [
                    {
                        "@id": "http://example.org/cstr#symptom_L_sensor_bias"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#fault_leak",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#Fault"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Tank leakage causing material loss proportional to liquid level. Leak rate coefficient k=0.005 L/s per L of level. Results in falling level and mass balance violation."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "Leak"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#FaultIsDescribedBySymptom": [
                    {
                        "@id": "http://example.org/cstr#symptom_L_low"
                    },
                    {
                        "@id": "http://example.org/cstr#symptom_mass_imbalance"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#diagnosticModel_LSTM_AE",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#DataBasedDiagnosticModel"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Data-based diagnostic model trained on 250 normal operation simulations. Architecture: Encoder with LSTM(64) -> Dropout(0.2) -> LSTM(32) -> Dense(32) latent space, Decoder with RepeatVector(50) -> LSTM(32) -> Dropout(0.2) -> LSTM(64) -> Dense(21). Input shape: (50, 21) representing 50 time steps of 21 features. Anomaly detection via reconstruction error threshold at 95th percentile of normal errors multiplied by 1.5."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "LSTM Autoencoder for CSTR Anomaly Detection"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#modelVersion": [
                    {
                        "@value": "1.0"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#DiagnosticsModelIsAssignedTo": [
                    {
                        "@id": "http://example.org/cstr#diagnostics_CSTR"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#diagnostics_CSTR",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#Diagnostics"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Real-time condition monitoring and fault diagnosis system for the CSTR reactor. Combines LSTM autoencoder for anomaly detection with rule-based symptom-to-fault mapping for fault identification and localization."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "CSTR Condition Monitoring System"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#hasInputSubject": [
                    {
                        "@id": "http://example.org/cstr#sensor_TT"
                    },
                    {
                        "@id": "http://example.org/cstr#tank_reactor"
                    },
