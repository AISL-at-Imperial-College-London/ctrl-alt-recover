                "@id": "http://example.org/cstr#feat_CB",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#Feature"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Normalized concentration sequence for species B (intermediate product). Derived from state x[2] in mol/L."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "Feature: Concentration B"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#feat_CC",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#Feature"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Normalized concentration sequence for species C (desired product). Derived from state x[3] in mol/L."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "Feature: Concentration C"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#feat_CD",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#Feature"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Normalized concentration sequence for species D (byproduct). Derived from state x[4] in mol/L."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "Feature: Concentration D"
                    }
                ]
            },
