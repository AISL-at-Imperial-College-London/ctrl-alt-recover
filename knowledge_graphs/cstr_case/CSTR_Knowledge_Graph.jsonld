                    "http://www.hsu-ifa.de/ontologies/DIN17359#Feature"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Feature for outlet flow. Low values indicate pump degradation or outlet blockage."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "Outlet Flow Feature (Fout)"
                    }
