                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Flow transmitter measuring outlet volumetric flow rate Fout. Located at outlet pipe after pump."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "Outlet Flow Sensor (FT-200)"
                    }
                ],
                "http://www.w3id.org/hsu-aut/VDI2206#isConnectedWith": [
