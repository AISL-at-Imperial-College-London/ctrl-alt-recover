            {
                "@id": "http://example.org/cstr#obs_param_Fin",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#Parameter",
                    "http://www.w3.org/ns/sosa/ObservableProperty"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Sampled inlet flow from information_Fin (PO1 output). Python: Fin = valve_in.flow(). Unit: L/s"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "obs_param_Fin – Inlet Flow"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#ParameterIsDescribedByFeature": [
                    {
                        "@id": "http://example.org/cstr#feat_Fin"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#ParameterIsDescribedByRefValue": [
                    {
                        "@id": "http://example.org/cstr#ref_Fin_sp"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#obs_param_Fout",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#Parameter",
                    "http://www.w3.org/ns/sosa/ObservableProperty"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Observable parameter: outlet flow rate from pump. Reduced flow indicates pump degradation or outlet blockage."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "obs_param_Fout"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#ParameterIsDescribedByFeature": [
                    {
                        "@id": "http://example.org/cstr#feat_Fout"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#Equation_PO3_HeatTransfer",
                "@type": [
                    "http://www.w3id.org/hsu-aut/VDI2206#MathematicalModel"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Heat transfer rate calculation with scaled UA based on cooling flow."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "Q_cool = UA_scaled × (T - Tc), where UA_scaled = UA_eff × (Fc / Fc_in_base)"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#obs_param_Fc",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#Parameter",
                    "http://www.w3.org/ns/sosa/ObservableProperty"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Sampled cooling flow from information_Fc (PO3 output). Python: cool_valve_in.flow(). Unit: L/s"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "obs_param_Fc – Cooling Flow"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#ParameterIsDescribedByFeature": [
                    {
                        "@id": "http://example.org/cstr#feat_Fc"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#obs_param_T_meas",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#Parameter",
                    "http://www.w3.org/ns/sosa/ObservableProperty"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Measured temperature with sensor noise and potential bias. Python: faults.sensor_T(t, T, 0.5)"
                    },
                    {
                        "@language": "en",
                        "@value": "Observable parameter: measured reactor temperature from sensor TT. Relevant features: feat_T_error."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "obs_param_T_meas – Measured Temperature"
                    },
                    {
                        "@language": "en",
                        "@value": "obs_param_T_meas"
                    }
                ],
                "http://www.w3.org/ns/sosa/isObservedBy": [
                    {
                        "@id": "http://example.org/cstr#sensor_TT"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#ParameterIsDescribedByFeature": [
                    {
                        "@id": "http://example.org/cstr#feat_T_error"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#ParameterIsDescribedByRefValue": [
                    {
                        "@id": "http://example.org/cstr#ref_T_sp"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#obs_param_L_meas",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#Parameter",
