                        "@language": "en",
                        "@value": "Inlet stream temperature with noise. Python: Tin = Tin_base * (1 + noise). Nominal: 350 K"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "Feed Temperature Tin"
                    }
                ]
            },
