                        "@value": "Flow transmitter measuring inlet volumetric flow rate Fin. Located at inlet pipe before reactor."
                    },
                    {
                        "@language": "en",
                        "@value": "Flow transmitter measuring inlet flow Fin. Python: Fin = valve_in.flow()"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "Inlet Flow Sensor (FT-100)"
                    },
                    {
                        "@language": "en",
                        "@value": "Inlet Flow Sensor (FT-101)"
                    }
                ],
                "http://www.w3id.org/hsu-aut/VDI2206#isConnectedWith": [
