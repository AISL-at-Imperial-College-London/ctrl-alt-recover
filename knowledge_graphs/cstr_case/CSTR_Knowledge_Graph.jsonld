            {
                "@id": "http://example.org/cstr#state_STARTUP",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/UMLStateMachine#State"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Filling phase: Fin active, Fout=0. Python: Phase.STARTUP"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "STARTUP Phase"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#state_NORMAL",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/UMLStateMachine#State"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Normal operation: all controllers active. Python: Phase.NORMAL"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "NORMAL Phase"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#state_SHUTDOWN",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/UMLStateMachine#State"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Draining phase: Fin=0, emptying reactor. Python: Phase.SHUTDOWN"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "SHUTDOWN Phase"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#transition_startup_normal",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/UMLStateMachine#Transition"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Trigger: L >= L_sp OR t >= T_startup"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "STARTUP → NORMAL"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/UMLStateMachine#transitionGuard": [
                    {
                        "@value": "(L >= L_sp) OR (t >= 1000.0)"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/UMLStateMachine#source": [
                    {
                        "@id": "http://example.org/cstr#state_STARTUP"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/UMLStateMachine#target": [
                    {
                        "@id": "http://example.org/cstr#state_NORMAL"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#transition_normal_shutdown",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/UMLStateMachine#Transition"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Trigger: t >= T_startup + T_normal"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "NORMAL → SHUTDOWN"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/UMLStateMachine#transitionGuard": [
                    {
                        "@value": "t >= 6000.0"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/UMLStateMachine#source": [
                    {
                        "@id": "http://example.org/cstr#state_NORMAL"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/UMLStateMachine#target": [
                    {
                        "@id": "http://example.org/cstr#state_SHUTDOWN"
                    }
                ]
            },
