                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#Feature"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Normalized inlet volumetric flow rate sequence. Computed from inlet valve position and pressure differential via valve_in.flow() method."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "Feature: Inlet Flow"
                    }
