                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#Equation_PO4_R1",
                "@type": [
                    "http://www.w3id.org/hsu-aut/VDI2206#MathematicalModel"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Reaction rate for A + D → B. Second-order reaction with Arrhenius temperature dependence."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "R1 = k01 × exp(-EA1 / (R × T)) × CA × CD"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#Equation_PO4_R2",
                "@type": [
                    "http://www.w3id.org/hsu-aut/VDI2206#MathematicalModel"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Reaction rate for A → C. First-order reaction with Arrhenius temperature dependence."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "R2 = k02 × exp(-EA2 / (R × T)) × CA"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#Equation_PO5_dV",
                "@type": [
                    "http://www.w3id.org/hsu-aut/VDI2206#MathematicalModel"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Volume balance: accumulation equals inlet minus outlet minus losses."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "dV/dt = Fin - Fout - F_leak - F_overflow"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#Equation_PO5_dCA",
                "@type": [
                    "http://www.w3id.org/hsu-aut/VDI2206#MathematicalModel"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Species A balance: convection in, convection out, consumption by both reactions."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "dCA/dt = (Fin/V) × CA_in - (Fout/V) × CA - R1 - R2"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#Equation_PO5_dCB",
                "@type": [
                    "http://www.w3id.org/hsu-aut/VDI2206#MathematicalModel"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Species B balance: convection out, production by reaction R1."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "dCB/dt = -(Fout/V) × CB + R1"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#Equation_PO5_dCC",
                "@type": [
                    "http://www.w3id.org/hsu-aut/VDI2206#MathematicalModel"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Species C balance: convection out, production by reaction R2."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "dCC/dt = -(Fout/V) × CC + R2"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#Equation_PO5_dCD",
                "@type": [
                    "http://www.w3id.org/hsu-aut/VDI2206#MathematicalModel"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Species D balance: convection in, convection out, consumption by reaction R1."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "dCD/dt = (Fin/V) × CD_in - (Fout/V) × CD - R1"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#Equation_PO5_dT",
                "@type": [
                    "http://www.w3id.org/hsu-aut/VDI2206#MathematicalModel"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Energy balance: convective heat, reaction heat release, jacket cooling."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "dT/dt = (Fin/V) × (Tin - T) + (-DH1 × R1 - DH2 × R2) / Cp - (UA_scaled / (V × Cp)) × (T - Tc)"
                    }
                ]
            },
