                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Actual inlet flow rate computed by PO1. Python: Fin = valve_in.flow(). Unit: L/s"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "Inlet Flow Fin"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/CPSMod#isCharacterizedByParameter": [
