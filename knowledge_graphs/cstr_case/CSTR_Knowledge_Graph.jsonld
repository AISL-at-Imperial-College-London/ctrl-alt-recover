                    "http://www.w3.org/ns/sosa/ActuatableProperty"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Actuation parameter: cooling valve command signal from controller."
                    },
                    {
                        "@language": "en",
                        "@value": "Actuatable parameter: cooling valve command signal from controller."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "obs_param_u_cool_cmd"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#ParameterIsDescribedByFeature": [
                    {
                        "@id": "http://example.org/cstr#feat_cool_cmd_actual_diff"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#feat_valve_cmd_actual_diff",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#Feature"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Difference |u_valve_cmd - u_valve|. Non-zero in steady-state indicates actuator fault."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "Valve Command-Actual Discrepancy"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#feat_pump_cmd_actual_diff",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#Feature"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Difference |u_pump_cmd - u_pump|. Non-zero in steady-state indicates actuator fault."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "Pump Command-Actual Discrepancy"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#feat_cool_cmd_actual_diff",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#Feature"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Difference |u_cool_cmd - u_cool|. Non-zero in steady-state indicates actuator fault."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "Cooling Valve Command-Actual Discrepancy"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#symptom_valve_cmd_actual_mismatch",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#Symptom"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Valve position does not follow controller command - indicates stiction or mechanical fault."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "Inlet Valve Command-Actual Mismatch"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#SymptomIsExtractedFromFeature": [
                    {
                        "@id": "http://example.org/cstr#feat_valve_cmd_actual_diff"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#SymptomDescribesFault": [
                    {
                        "@id": "http://example.org/cstr#fault_inlet_stuck_open"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#symptom_pump_cmd_actual_mismatch",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#Symptom"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Pump speed does not follow controller command - indicates mechanical degradation."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "Pump Command-Actual Mismatch"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#SymptomIsExtractedFromFeature": [
                    {
                        "@id": "http://example.org/cstr#feat_pump_cmd_actual_diff"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#SymptomDescribesFault": [
                    {
                        "@id": "http://example.org/cstr#fault_pump_degrade"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#symptom_cool_cmd_actual_mismatch",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#Symptom"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Cooling valve position does not follow controller command - indicates stiction or stuck."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "Cooling Valve Command-Actual Mismatch"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#SymptomIsExtractedFromFeature": [
                    {
                        "@id": "http://example.org/cstr#feat_cool_cmd_actual_diff"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#SymptomDescribesFault": [
                    {
                        "@id": "http://example.org/cstr#fault_cool_stuck_open"
                    },
                    {
                        "@id": "http://example.org/cstr#fault_cool_stuck_closed"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#ref_Fout_nominal",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#ReferenceValue"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Expected outlet flow in steady state (should equal Fin)"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "Outlet Flow Nominal"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#referenceValue": [
                    {
                        "@value": "3.33e-2",
                        "@type": "http://www.w3.org/2001/XMLSchema#double"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#referenceUnit": [
                    {
                        "@value": "L/s"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#referenceConditions": [
                    {
                        "@language": "en",
                        "@value": "Steady state at L_sp = 10 L"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#IsUsedToIdentifySymptom": [
                    {
                        "@id": "http://example.org/cstr#symptom_Fout_low"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#feat_u_cool_pos",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#Feature"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Feature for actual cooling valve position [0-1]."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "Cooling Valve Position Feature"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#feat_u_cool_saturation",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#Feature"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Combined feature: cooling valve at saturation (≈1.0) while temperature error persists. Indicates insufficient cooling capacity."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "Cooling Valve Saturation Feature"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#FeatureConsistsOfFeature": [
                    {
                        "@id": "http://example.org/cstr#feat_T_error"
                    },
                    {
                        "@id": "http://example.org/cstr#feat_u_cool_pos"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#feat_u_pump_speed",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#Feature"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Feature for actual pump speed [0-1]."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "Pump Speed Feature"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#feat_u_pump_saturation",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#Feature"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Combined feature: pump at maximum speed while level error persists. Indicates pump degradation or outlet blockage."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "Pump Saturation Feature"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#FeatureConsistsOfFeature": [
                    {
                        "@id": "http://example.org/cstr#feat_L_error"
                    },
                    {
                        "@id": "http://example.org/cstr#feat_u_pump_speed"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#symptom_u_pump_sat_high",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#Symptom"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Pump at maximum speed but level still above setpoint. Indicates pump degradation or outlet blockage."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "S7b: Pump Saturated High"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#SymptomIsExtractedFromFeature": [
                    {
                        "@id": "http://example.org/cstr#feat_u_pump_saturation"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#SymptomDescribesFault": [
                    {
                        "@id": "http://example.org/cstr#fault_pump_degrade"
                    },
                    {
                        "@id": "http://example.org/cstr#fault_outlet_block"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#state_FAULT",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/UMLStateMachine#State"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Fault state entered when diagnostic system detects one of the defined faults (fault_fouling, fault_cool_stuck_open, fault_cool_stuck_closed, fault_pump_degrade, fault_outlet_block, fault_inlet_stuck_open, fault_temp_bias, fault_level_bias, fault_leak). System attempts recovery or initiates controlled shutdown.  Phase.FAULT"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "FAULT Phase"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#transition_normal_fault",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/UMLStateMachine#Transition"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Triggered when monitoring system identifies faulty behavior. Any detected anomaly will trigger this transition."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "NORMAL → FAULT"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/UMLStateMachine#transitionGuard": [
                    {
                        "@value": "anomaly_detected == True"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/UMLStateMachine#source": [
                    {
                        "@id": "http://example.org/cstr#state_NORMAL"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/UMLStateMachine#target": [
                    {
                        "@id": "http://example.org/cstr#state_FAULT"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#transition_fault_normal",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/UMLStateMachine#Transition"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Triggered when fault is resolved during operation by the action agent. System returns to normal operation if fault is cleared within recovery time window."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "FAULT → NORMAL"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/UMLStateMachine#transitionGuard": [
                    {
                        "@value": "corrective_action.found == True AND t < t_fault + t_recovery_max"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/UMLStateMachine#source": [
                    {
                        "@id": "http://example.org/cstr#state_FAULT"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/UMLStateMachine#target": [
                    {
                        "@id": "http://example.org/cstr#state_NORMAL"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#transition_fault_shutdown",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/UMLStateMachine#Transition"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Triggered when fault cannot be resolved within defined recovery time window (t_recovery_max, not yet specified) or when critical safety threshold is exceeded. Initiates controlled shutdown to prevent equipment damage or safety hazards."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "FAULT → SHUTDOWN"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/UMLStateMachine#transitionGuard": [
                    {
                        "@value": "t >= t_fault + t_recovery_max OR critical_threshold_exceeded == True"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/UMLStateMachine#source": [
                    {
                        "@id": "http://example.org/cstr#state_FAULT"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/UMLStateMachine#target": [
                    {
                        "@id": "http://example.org/cstr#state_SHUTDOWN"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#obs_param_u_cool_pos",
                "http://www.hsu-ifa.de/ontologies/DIN17359#ParameterIsDescribedByFeature": [
                    {
                        "@id": "http://example.org/cstr#feat_u_cool_pos"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#obs_param_u_pump_speed",
                "http://www.hsu-ifa.de/ontologies/DIN17359#ParameterIsDescribedByFeature": [
                    {
                        "@id": "http://example.org/cstr#feat_u_pump_speed"
                    }
                ]
            }
        ]
    }
]