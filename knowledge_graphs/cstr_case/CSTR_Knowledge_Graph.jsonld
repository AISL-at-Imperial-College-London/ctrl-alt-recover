                    }
                ],
                "http://www.hsu-ifa.de/ontologies/CPSMod#isObservedBySensor": [
                    {
                        "@id": "http://example.org/cstr#sensor_outlet_FT"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#information_UA_eff",
                "@type": [
                    "http://www.w3id.org/hsu-aut/VDI3682#Information"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Effective UA accounting for fouling. Python: UA_eff = faults.UA_eff(t)"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "Effective Heat Transfer Coefficient UA_eff"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#information_Fc",
                "@type": [
                    "http://www.w3id.org/hsu-aut/VDI3682#Information"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Actual cooling water flow computed by PO3. Python: Fc = cool_valve_in.flow(). Unit: L/s"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "Cooling Flow Fc"
