                "http://www.hsu-ifa.de/ontologies/CPSMod#isObservedBySensor": [
                    {
                        "@id": "http://example.org/cstr#sensor_cooling_FT"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#information_Cp",
                "@type": [
                    "http://www.w3id.org/hsu-aut/VDI3682#Information"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Specific heat capacity of mixture. Python: Cp = 4180 J/(kg·K)"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "Heat Capacity Cp"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DINEN61360#has_Data_Element": [
                    {
                        "@id": "http://example.org/cstr#DE_Cp"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#information_DH1",
                "@type": [
                    "http://www.w3id.org/hsu-aut/VDI3682#Information"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Enthalpy change for reaction A + D → B. Python: DH1 = -1000 J/mol (exothermic)"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "Reaction Enthalpy DH1"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DINEN61360#has_Data_Element": [
                    {
                        "@id": "http://example.org/cstr#DE_DH1"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#information_DH2",
                "@type": [
                    "http://www.w3id.org/hsu-aut/VDI3682#Information"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Enthalpy change for reaction A → C. Python: DH2 = -1000 J/mol (exothermic)"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "Reaction Enthalpy DH2"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DINEN61360#has_Data_Element": [
                    {
                        "@id": "http://example.org/cstr#DE_DH2"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#information_F_leak",
                "@type": [
                    "http://www.w3id.org/hsu-aut/VDI3682#Information"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Flow rate due to leakage. Python: faults.leak_flow(t, V)"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "Leak Flow F_leak"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#information_F_overflow",
                "@type": [
                    "http://www.w3id.org/hsu-aut/VDI3682#Information"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Flow rate due to overflow protection. Python: faults.overflow_flow(V)"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "Overflow Flow F_overflow"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#information_L_meas",
                "@type": [
                    "http://www.w3id.org/hsu-aut/VDI3682#Information"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Level measurement from sensor LT (used by PO6)."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "Measured Level L_meas"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/CPSMod#isCharacterizedByParameter": [
                    {
                        "@id": "http://example.org/cstr#obs_param_L_meas"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/CPSMod#isObservedBySensor": [
                    {
                        "@id": "http://example.org/cstr#sensor_LT"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#PO2_OutletFlow",
                "@type": [
                    "http://www.w3id.org/hsu-aut/VDI3682#ProcessOperator"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Computes effective outlet flow from pump speed and degradation factor. Well-mixed: C_out = C_reactor."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "PO2 – Outlet Effective Flow"
                    }
                ],
                "http://www.w3id.org/hsu-aut/VDI3682#isAssignedTo": [
                    {
                        "@id": "http://example.org/cstr#module_Outlet"
                    }
                ],
                "http://www.w3id.org/hsu-aut/VDI3682#hasInput": [
                    {
                        "@id": "http://example.org/cstr#product_CA_out"
                    },
                    {
                        "@id": "http://example.org/cstr#product_CB_out"
                    },
                    {
                        "@id": "http://example.org/cstr#product_CC_out"
                    },
                    {
                        "@id": "http://example.org/cstr#product_CD_out"
                    },
                    {
                        "@id": "http://example.org/cstr#information_Kq_pump"
                    },
                    {
                        "@id": "http://example.org/cstr#information_pump_flow_factor"
                    },
                    {
                        "@id": "http://example.org/cstr#information_u_pump_cmd"
                    }
                ],
                "http://www.w3id.org/hsu-aut/VDI3682#hasOutput": [
                    {
                        "@id": "http://example.org/cstr#information_Fout"
                    },
                    {
                        "@id": "http://example.org/cstr#product_CA_out"
                    },
                    {
                        "@id": "http://example.org/cstr#product_CB_out"
                    },
                    {
                        "@id": "http://example.org/cstr#product_CC_out"
                    },
                    {
                        "@id": "http://example.org/cstr#product_CD_out"
                    },
                    {
                        "@id": "http://example.org/cstr#information_u_pump"
                    }
                ],
                "http://www.w3id.org/hsu-aut/VDI3682#hasSuccessor": [
                    {
                        "@id": "http://example.org/cstr#PO5_StateDerivatives"
                    }
                ],
                "http://www.w3id.org/hsu-aut/VDI3682#hasPredecessor": [
                    {
                        "@id": "http://example.org/cstr#PO6_LevelPID"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/CPSMod#processRealizesBehavior": [
                    {
                        "@id": "http://example.org/cstr#Equation_PO2_OutletFlow"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#PO3_CoolingFlow",
                "@type": [
                    "http://www.w3id.org/hsu-aut/VDI3682#ProcessOperator"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Computes cooling water flow and effective heat removal rate."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "PO3 – Cooling Flow and Heat Transfer"
                    }
                ],
                "http://www.w3id.org/hsu-aut/VDI3682#isAssignedTo": [
                    {
                        "@id": "http://example.org/cstr#module_Cooling"
                    }
                ],
                "http://www.w3id.org/hsu-aut/VDI3682#hasInput": [
                    {
                        "@id": "http://example.org/cstr#information_T_meas"
                    },
                    {
                        "@id": "http://example.org/cstr#energy_Tc"
                    },
                    {
                        "@id": "http://example.org/cstr#information_UA_eff"
                    },
                    {
                        "@id": "http://example.org/cstr#information_Cv_max_cool"
                    },
                    {
                        "@id": "http://example.org/cstr#information_Fc_in_base"
                    },
                    {
                        "@id": "http://example.org/cstr#information_u_cool_cmd"
                    }
                ],
                "http://www.w3id.org/hsu-aut/VDI3682#hasOutput": [
                    {
                        "@id": "http://example.org/cstr#information_Fc"
                    },
                    {
                        "@id": "http://example.org/cstr#information_u_cool"
                    },
                    {
                        "@id": "http://example.org/cstr#energy_Q_cool"
                    }
                ],
                "http://www.w3id.org/hsu-aut/VDI3682#hasSuccessor": [
                    {
                        "@id": "http://example.org/cstr#PO5_StateDerivatives"
                    }
                ],
                "http://www.w3id.org/hsu-aut/VDI3682#hasPredecessor": [
                    {
                        "@id": "http://example.org/cstr#PO7_TempPID"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/CPSMod#processRealizesBehavior": [
                    {
                        "@id": "http://example.org/cstr#Equation_PO3_CoolingFlow"
                    },
                    {
                        "@id": "http://example.org/cstr#Equation_PO3_HeatTransfer"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#Equation_PO6_LevelPID",
                "@type": [
                    "http://www.w3id.org/hsu-aut/VDI2206#MathematicalModel"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Level controller with feedforward from inlet flow. Reverse-acting: higher level increases pump output."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "u_pump = u_ff + Kp_L × e + Ki_L × ∫e dt, where e = L_meas - L_sp, u_ff = Fin / Kq"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#obs_param_dT_dt",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#Parameter"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Sampled from information_dT_dt (PO5 output). Rate of temperature change."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "obs_param_dT_dt – Temperature Derivative"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#ParameterIsDescribedByFeature": [
                    {
                        "@id": "http://example.org/cstr#feat_dT_dt"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#CSTR_StateMachine",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/UMLStateMachine#StateMachine"
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "CSTR Operation State Machine"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/UMLStateMachine#contains": [
                    {
                        "@id": "http://example.org/cstr#state_STARTUP"
                    },
                    {
                        "@id": "http://example.org/cstr#state_NORMAL"
                    },
                    {
                        "@id": "http://example.org/cstr#state_SHUTDOWN"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#CSTR_System",
                "@type": [
                    "http://www.w3id.org/hsu-aut/VDI2206#System"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Digital twin of CSTR simulation with 3 control loops: Inlet Flow, Level, Temperature."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "CSTR – Continuous Stirred-Tank Reactor"
                    }
                ],
                "http://www.w3id.org/hsu-aut/VDI2206#SystemConsistsOfModule": [
                    {
                        "@id": "http://example.org/cstr#module_Inlet"
                    },
                    {
                        "@id": "http://example.org/cstr#module_Outlet"
                    },
                    {
                        "@id": "http://example.org/cstr#module_Cooling"
                    },
                    {
                        "@id": "http://example.org/cstr#module_Reactor"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#Equation_PO1_InletFlow",
                "@type": [
                    "http://www.w3id.org/hsu-aut/VDI2206#MathematicalModel"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Effective inlet flow calculation. Python: Fin = valve_in.flow() = Cv_max * opening"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "Fin = Cv_max_valve × valve_opening"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#Equation_PO8_FlowPID",
                "@type": [
                    "http://www.w3id.org/hsu-aut/VDI2206#MathematicalModel"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Flow controller. Lower flow opens valve more."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "u_valve = Kp_F × e + Ki_F × ∫e dt, where e = Fin_sp - Fin_meas"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#Equation_PO2_OutletFlow",
                "@type": [
                    "http://www.w3id.org/hsu-aut/VDI2206#MathematicalModel"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Effective outlet flow with degradation. Python: Fout = pump_out.flow() * faults.pump_flow_factor(t)"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "Fout = Kq_pump × pump_speed × pump_flow_factor(t)"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#Equation_PO3_CoolingFlow",
                "@type": [
                    "http://www.w3id.org/hsu-aut/VDI2206#MathematicalModel"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Cooling water flow calculation. Python: Fc = cool_valve_in.flow() = Cv_max * opening"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "Fc = Cv_max_cool × cool_opening"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#Equation_PO7_TempPID",
                "@type": [
                    "http://www.w3id.org/hsu-aut/VDI2206#MathematicalModel"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Temperature controller. Higher temperature opens cooling valve more."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "u_cool = Kp_T × e + Ki_T × ∫e dt, where e = T_meas - T_sp (reverse-acting)"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#CSTR_Process",
                "@type": [
                    "http://www.w3id.org/hsu-aut/VDI3682#Process"
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "CSTR Reaction Process"
                    }
                ],
                "http://www.w3id.org/hsu-aut/VDI3682#hasInput": [
                    {
                        "@id": "http://example.org/cstr#product_CA_in"
                    },
                    {
                        "@id": "http://example.org/cstr#product_CD_in"
                    },
                    {
                        "@id": "http://example.org/cstr#energy_Tc"
                    },
                    {
                        "@id": "http://example.org/cstr#energy_Tin"
                    }
                ],
                "http://www.w3id.org/hsu-aut/VDI3682#hasOutput": [
                    {
                        "@id": "http://example.org/cstr#information_T_meas"
                    },
                    {
                        "@id": "http://example.org/cstr#information_L_meas"
                    },
                    {
                        "@id": "http://example.org/cstr#product_CA_out"
                    },
                    {
                        "@id": "http://example.org/cstr#product_CB_out"
                    },
                    {
                        "@id": "http://example.org/cstr#product_CC_out"
                    },
                    {
                        "@id": "http://example.org/cstr#product_CD_out"
                    }
                ],
                "http://www.w3id.org/hsu-aut/VDI3682#consistsOf": [
                    {
                        "@id": "http://example.org/cstr#PO4_ReactionRates"
                    },
                    {
                        "@id": "http://example.org/cstr#PO5_StateDerivatives"
                    },
                    {
                        "@id": "http://example.org/cstr#PO1_InletFlow"
                    },
                    {
                        "@id": "http://example.org/cstr#PO2_OutletFlow"
                    },
                    {
                        "@id": "http://example.org/cstr#PO3_CoolingFlow"
                    },
                    {
                        "@id": "http://example.org/cstr#PO6_LevelPID"
                    },
                    {
                        "@id": "http://example.org/cstr#PO7_TempPID"
                    },
                    {
