            {
                "@id": "http://example.org/cstr#heat_exchanger",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/DIN17359#DiagnosticSubject",
                    "http://www.w3id.org/hsu-aut/VDI2206#Component"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Shell-and-tube heat exchanger for reactor cooling. Cooling water flows through shell side, reactor fluid through tubes. Subject to fouling degradation over time."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "Heat Exchanger HX-100"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/DIN17359#DiagnosticSubjectHasFault": [
                    {
                        "@id": "http://example.org/cstr#fault_fouling"
                    }
                ]
            },
