                    },
                    {
                        "@id": "http://example.org/cstr#actuator_valve_in"
                    },
                    {
                        "@id": "http://example.org/cstr#actuator_pump_out"
                    },
                    {
                        "@id": "http://example.org/cstr#pipe_outlet"
                    },
                    {
                        "@id": "http://example.org/cstr#actuator_cool_valve"
                    },
                    {
