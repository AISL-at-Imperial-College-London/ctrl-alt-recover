                    }
                ],
                "http://www.hsu-ifa.de/ontologies/CPSMod#isObservedBySensor": [
                    {
                        "@id": "http://example.org/cstr#sensor_inlet_FT"
                    }
                ]
            },
            {
                "@id": "http://example.org/cstr#information_Fout",
                "@type": [
                    "http://www.w3id.org/hsu-aut/VDI3682#Information"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Actual outlet flow rate computed by PO2. Python: Fout = pump_out.flow() * pump_flow_factor. Unit: L/s"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "Outlet Flow Fout"
                    }
