            },
            {
                "@id": "http://www.w3.org/ns/sosa/Observation",
                "@type": [
                    "http://www.w3.org/2002/07/owl#Class"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@value": "An event resulting from a sensor observing a property of a feature of interest."
                    }
                ]
            },
            {
                "@id": "http://www.w3.org/ns/sosa/Actuation",
                "@type": [
                    "http://www.w3.org/2002/07/owl#Class"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@value": "An event where an actuator acts upon a property to change its state."
                    }
