                    {
                        "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Type_Description"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@value": "Description:\nA mathematical euqation that is being used for characterization of the data element\n\nLiability: Optional\n\nDIN EN 61360-1:2018 Section 6.5\n\nType: contains a URL link as a string to a source file that describes the formula\n\nPoposed Data Range Expression: xsd:string"
                    }
                ]
            },
            {
                "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#List_Member_Position",
                "@type": [
                    "http://www.w3.org/2002/07/owl#DatatypeProperty"
                ],
                "http://www.w3.org/2000/01/rdf-schema#domain": [
                    {
                        "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#List_Member"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#range": [
                    {
                        "@id": "http://www.w3.org/2001/XMLSchema#int"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@value": "Description:\n\nDataProperty that indicates the position of a List_Member in a DataType List."
                    }
                ]
            },
            {
                "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#List_Member",
                "@type": [
                    "http://www.w3.org/2002/07/owl#Class"
                ],
                "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
                    {
                        "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Complex_Data_Type_Member"
                    },
                    {
                        "@id": "_:node1227"
                    }
                ]
            },
            {
                "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Logic_Interpretation",
                "@type": [
                    "http://www.w3.org/2002/07/owl#DatatypeProperty",
                    "http://www.w3.org/2002/07/owl#FunctionalProperty"
                ],
                "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
                    {
                        "@id": "http://www.w3.org/2002/07/owl#topDataProperty"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#domain": [
                    {
                        "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Instance_Description"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#range": [
                    {
                        "@id": "_:node1177"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@value": "Description:\n\nIndicates, whether a value with a certain Expression Goal has to be considered as equal (\"=\"), greater than (\"<\"), lower than (\">\") or in combination with an equals (i.e. \"<=\", \">=\").\n\nLiability: Necessary"
                    }
                ]
            },
            {
                "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Note",
                "@type": [
                    "http://www.w3.org/2002/07/owl#DatatypeProperty"
                ],
                "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
                    {
                        "@id": "http://www.w3.org/2002/07/owl#topDataProperty"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#domain": [
                    {
                        "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Type_Description"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@value": "Description:\nAdditional information that are important to understand the meaning of the data element\n\nLiability: Optional\n\nDIN EN 61360-1:2018 Section 8.4\n\nType: String\n\nPoposed Data Range Expression: xsd:string"
                    }
                ]
            },
            {
                "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Preferred_Letter_Symbol",
                "@type": [
                    "http://www.w3.org/2002/07/owl#DatatypeProperty"
                ],
                "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
                    {
                        "@id": "http://www.w3.org/2002/07/owl#topDataProperty"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#domain": [
                    {
                        "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Type_Description"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@value": "Description:\nA sign or literal that is used to represent the property (e.g. greek \"sigma\" for tension))\n\nLiability: Optional\n\nDIN EN 61360-1:2018 Section 6.6\n\nType: IEC 60027, IEC 60747 or IEC 60148 compliant formula sign described as a string\n\nPoposed Data Range Expression: xsd:string"
                    }
                ]
            },
            {
                "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Preferred_Name",
                "@type": [
                    "http://www.w3.org/2002/07/owl#DatatypeProperty"
                ],
                "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
                    {
                        "@id": "http://www.w3.org/2002/07/owl#topDataProperty"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#domain": [
                    {
                        "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Type_Description"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@value": "Description:\nRepresents the preferred name of the data element type, that is being used for searches for instance.\n\nLiability: Necessary\n\nDIN EN 61360-1:2018 Section 7.4\n\nType: String with lower and upper case, with a maximum of 70 characters\n\nPoposed Data Range Expression: xsd:string[maxLength 70]"
                    }
                ]
            },
            {
                "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Quality",
                "@type": [
                    "http://www.w3.org/2002/07/owl#DatatypeProperty"
                ],
                "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
                    {
                        "@id": "http://www.w3.org/2002/07/owl#topDataProperty"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#domain": [
                    {
                        "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Instance_Description"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@value": "Description:\n\nNot supported so far, since it requires a additional quality ontology"
                    }
                ]
            },
            {
                "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Remark",
                "@type": [
                    "http://www.w3.org/2002/07/owl#DatatypeProperty"
                ],
                "http://www.w3.org/2000/01/rdf-schema#domain": [
                    {
                        "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Type_Description"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@value": "Additional information that can be used to express a oppinion but should not change the meaning of the definition.\nDIN EN 61360-1:2018 Section 8.5"
                    }
                ]
            },
            {
                "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Revision_Number",
                "@type": [
                    "http://www.w3.org/2002/07/owl#DatatypeProperty"
                ],
                "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
                    {
                        "@id": "http://www.w3.org/2002/07/owl#topDataProperty"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#domain": [
                    {
                        "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Type_Description"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@value": "Description:\nNumber that represents the actual count of changes\n\nLiability: Necessary\n\nDIN EN 61360-1:2018 Section 7.5\n\nType: Integer with two digits between 1 and 99\n\nPoposed Data Range Expression: xsd:integer[>= 1 , <= 99]"
                    }
                ]
            },
            {
                "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Short_Name",
                "@type": [
                    "http://www.w3.org/2002/07/owl#DatatypeProperty"
                ],
                "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
                    {
                        "@id": "http://www.w3.org/2002/07/owl#topDataProperty"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#domain": [
                    {
                        "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Type_Description"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@value": "Description:\nA short name or acronym that is used for the preferred name\n\nLiability: Necessary\n\nDIN EN 61360-1:2018 Section 7.6\n\nType: Strong restrictions of DIN61360  not implemented, just strings necessary. Maximum characters is 17.\n\nPoposed Data Range Expression: xsd:string[maxLength 17]"
                    }
                ]
            },
            {
                "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Source_Document_of_Definition",
                "@type": [
                    "http://www.w3.org/2002/07/owl#DatatypeProperty"
                ],
                "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
                    {
                        "@id": "http://www.w3.org/2002/07/owl#topDataProperty"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#domain": [
                    {
                        "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Type_Description"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@value": "Description:\nA link to a source file, where the definition of the data element was taken from\n\nLiability: Optional\n\nDIN EN 61360-1:2018 Section 8.6\n\nType: Should contain a description of the source document with a maximum of 80 characters. Document has to be approved by ISO or IEC (e.g. should be a standard like IEC XXXXX). Alternatively use a URL to give a source document that is not approved by ISO.\n\nPoposed Data Range Expression: xsd:string"
                    }
                ]
            },
            {
                "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Synonymous_Letter_Symbol",
                "@type": [
                    "http://www.w3.org/2002/07/owl#DatatypeProperty"
                ],
                "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
                    {
                        "@id": "http://www.w3.org/2002/07/owl#topDataProperty"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#domain": [
                    {
                        "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Type_Description"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@value": "Description:\nA synonym that is used for the preferred equation sign\n\nLiability: Optional\n\nDIN EN 61360-1:2018 Section 6.7\n\nType: IEC 60027, IEC 60747 or IEC 60148 compliant formula sign\n\nPoposed Data Range Expression: xsd:string"
                    }
                ]
            },
            {
                "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Synonymous_Name",
                "@type": [
                    "http://www.w3.org/2002/07/owl#DatatypeProperty"
                ],
                "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
                    {
                        "@id": "http://www.w3.org/2002/07/owl#topDataProperty"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#domain": [
                    {
                        "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Type_Description"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@value": "Description:\nSynonyms to the preferred name\n\nLiability: Optional\n\nDIN EN 61360-1:2018 Section 7.7\n\nType: String with lower and upper case, with a maximum of 70 characters\n\nPoposed Data Range Expression: xsd:string[maxLength 70]"
                    }
                ]
            },
            {
                "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Unit_of_Measure",
                "@type": [
                    "http://www.w3.org/2002/07/owl#DatatypeProperty"
                ],
                "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
                    {
                        "@id": "http://www.w3.org/2002/07/owl#topDataProperty"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#domain": [
                    {
                        "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Type_Description"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@value": "Description:\nDefines the unit of measure for a data element (e.g. km/h)\n\nLiability: case dependend, checked by SWRL rule 2\n\nDIN EN 61360-1:2018 Section 10.7\n\nType: This data property represents the unit of measure, which should be ISO 31 compliant (SI-Units)\n\nPoposed Data Range Expression: xsd:string"
                    }
                ]
            },
            {
                "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Value",
                "@type": [
                    "http://www.w3.org/2002/07/owl#DatatypeProperty",
                    "http://www.w3.org/2002/07/owl#FunctionalProperty"
                ],
                "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
                    {
                        "@id": "http://www.w3.org/2002/07/owl#topDataProperty"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#domain": [
                    {
                        "@id": "_:node1183"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@value": "Description:\n\nThe actual value of something being described.\n\nLiability: Necessary\n\nSemAnz40\n\nType: This data property represents the value of the data element, which is a string, while the actual data type is represented by the Data Property DataType (!)\n\nPoposed Data Range Expression: xsd:string"
                    }
                ]
            },
            {
                "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Simple_Data_Type",
                "@type": [
                    "http://www.w3.org/2002/07/owl#Class"
                ],
                "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
                    {
                        "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Data_Type"
                    },
                    {
                        "@id": "_:node1230"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@value": "Description:\nIndicates which kind of DataType a data element must be. This does not include all data types of DIN61360! \n\nLiability: Necessary\n\nDIN61360: 3.4.1\n\nType: is a enumeration of standard compliant data types. Please see DIN61360 for a description of level/class-instance/list/set/bag/array"
                    }
                ]
            },
            {
                "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Value_Format_Field_length",
                "@type": [
                    "http://www.w3.org/2002/07/owl#DatatypeProperty"
                ],
                "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
                    {
                        "@id": "http://www.w3.org/2002/07/owl#topDataProperty"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#domain": [
                    {
                        "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Type_Description"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@value": "Description:\nDefines the representation of a data element in length and kind. See DIN61360 for detailed description of possible formats. Possible definitions include non-quantitative formats, quantitative formats and maximum count of characters\n\nLiability: Necessary\n\nDIN EN 61360-1:2018 Section 10.8\n\nType: This data property represents only the field length, since this could be exponential (expressed with an E), it is a string\n\nPoposed Data Range Expression: xsd:string"
                    }
                ]
            },
            {
                "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Value_Format_Field_length_Variable",
                "@type": [
                    "http://www.w3.org/2002/07/owl#DatatypeProperty"
                ],
                "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
                    {
                        "@id": "http://www.w3.org/2002/07/owl#topDataProperty"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#domain": [
                    {
                        "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Type_Description"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@value": "Description:\nDefines the representation of a data element in length and kind. See DIN61360 for detailed description of possible formats. Possible definitions include non-quantitative formats, quantitative formats and maximum count of characters\n\nLiability: Necessary\n\nDIN EN 61360-1:2018 Section 10.8\n\nType: This data property represents only the case, that a value format has a variable field length (true)\n\nPoposed Data Range Expression: xsd:boolean"
                    }
                ]
            },
            {
                "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Value_Format_non-quantitativ",
                "@type": [
                    "http://www.w3.org/2002/07/owl#DatatypeProperty"
                ],
                "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
                    {
                        "@id": "http://www.w3.org/2002/07/owl#topDataProperty"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#domain": [
                    {
                        "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Type_Description"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#range": [
                    {
                        "@id": "_:node1187"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@value": "Description:\nDefines the representation of a data element in length and kind. See DIN61360 for detailed description of possible formats. Possible definitions include non-quantitative formats, quantitative formats and maximum count of characters\n\nLiability: Necessary\n\nDIN EN 61360-1:2018 Section 10.8\n\nType: This data property represents only the non-quantitativ formats, string\n\nPoposed Data Range Expression: xsd:string"
                    }
                ],
                "http://www.w3.org/2002/07/owl#propertyDisjointWith": [
                    {
                        "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Value_Format_quantitativ"
                    }
                ]
            },
            {
                "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Value_Format_quantitativ",
                "@type": [
                    "http://www.w3.org/2002/07/owl#DatatypeProperty"
                ],
                "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
                    {
                        "@id": "http://www.w3.org/2002/07/owl#topDataProperty"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#domain": [
                    {
                        "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Type_Description"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#range": [
                    {
                        "@id": "_:node1193"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@value": "Description:\nDefines the representation of a data element in length and kind. See DIN61360 for detailed description of possible formats. Possible definitions include non-quantitative formats, quantitative formats and maximum count of characters\n\nLiability: Necessary\n\nDIN EN 61360-1:2018 Section 10.8\n\nType: This data property represents only the quantitativ formats, string\n\nPoposed Data Range Expression: xsd:string"
                    }
                ]
            },
            {
                "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Value_List",
                "@type": [
                    "http://www.w3.org/2002/07/owl#DatatypeProperty"
                ],
                "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
                    {
                        "@id": "http://www.w3.org/2002/07/owl#topDataProperty"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#domain": [
                    {
                        "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Simple_Data_Type"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@value": "Description: \nRepresents the possible values for a data element\n\nLiability: optional (in DIN613060 case depended due to classification of data element, which is not implemented here)\n\nDIN EN 61360-1:2018 Section 16\n\nType: This data property represents the information, if there is a value list (if so, true), basically the values that the data property \"Value\" is allowed to hold. \n\nPoposed Data Range Expression: xsd:boolean"
                    }
                ]
            },
            {
                "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Value_List_Member",
                "@type": [
                    "http://www.w3.org/2002/07/owl#DatatypeProperty"
                ],
                "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
                    {
                        "@id": "http://www.w3.org/2002/07/owl#topDataProperty"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#domain": [
                    {
                        "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Simple_Data_Type"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@value": "Description: \nRepresents the possible values for a data element\n\nLiability: optional (in DIN613060 case depended due to classification of data element, which is not implemented here)\n\nDIN EN 61360-1:2018 Section 16\n\nType: This data property represents the one (!) member of the value list, violation may result in inconsistency, since the compliance of value list and value is checked by SWRL rule 3. \n\nPoposed Data Range Expression: xsd:string"
                    }
                ]
            },
            {
                "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Version_Number",
                "@type": [
                    "http://www.w3.org/2002/07/owl#DatatypeProperty"
                ],
                "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
                    {
                        "@id": "http://www.w3.org/2002/07/owl#topDataProperty"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#domain": [
                    {
                        "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Type_Description"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@value": "Description:\nNumber that indicates different versions of one data element type\n\nLiability: Necessary\n\nDIN EN 61360-1:2018 Section 7.8\n\nType: Integer with three digits max, so between 1 and 999\n\nPoposed Data Range Expression: xsd:integer[>= 1 , <= 999]"
                    }
                ]
            },
            {
                "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#backwards_compatible_Revision",
                "@type": [
                    "http://www.w3.org/2002/07/owl#DatatypeProperty"
                ],
                "http://www.w3.org/2000/01/rdf-schema#domain": [
                    {
                        "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Type_Description"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@value": "Description:\nIndicates, to which revisions the data type is backwards compatible.\n\nType: Integer\n\nPoposed Data Range Expression: xsd:string"
                    }
                ]
            },
            {
                "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#backwards_compatible_Version",
