                    "http://www.w3.org/2002/07/owl#Ontology"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@value": "Lightweight SOSA Ontology subset used for Sensor and Actuator Observation"
                    }
