            },
            {
                "@id": "http://www.w3.org/ns/sosa/ObservableProperty",
                "@type": [
                    "http://www.w3.org/2002/07/owl#Class"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@value": "A property that can be observed by a sensor."
                    }
                ]
            },
            {
                "@id": "http://www.w3.org/ns/sosa/ActuableProperty",
                "@type": [
                    "http://www.w3.org/2002/07/owl#Class"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@value": "A property that can be acted upon by an actuator."
                    }
                ]
            },
