            },
            {
                "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Code",
                "@type": [
                    "http://www.w3.org/2002/07/owl#DatatypeProperty",
                    "http://www.w3.org/2002/07/owl#FunctionalProperty"
                ],
                "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
                    {
                        "@id": "http://www.w3.org/2002/07/owl#topDataProperty"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#domain": [
                    {
                        "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Type_Description"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@value": "Description:\nDIN EN 61360-1:2018 Section 7.3\nUnique identifier of this data element type. Preferable this should be a standardized identifier (e.g. from eclss or common data dictionary).  optional exlusion of \"o\" and \"i\" is not implemented.    \n\nLiability: necessary    \n\ntype: string with 6 digits between, first three digits are a-z and last three digits are 0-9  poposed data range expression: xsd:string[pattern \"[a-z0-9] {6}\"]"
                    }
                ]
            },
            {
                "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Created_at_Date",
                "@type": [
                    "http://www.w3.org/2002/07/owl#DatatypeProperty"
                ],
                "http://www.w3.org/2000/01/rdf-schema#domain": [
                    {
                        "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Instance_Description"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#range": [
                    {
                        "@id": "http://www.w3.org/2001/XMLSchema#dateTimeStamp"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@value": "Description: \nA SemAnz40 attribute, that indicates the creation date for an instance."
                    }
                ]
            },
            {
                "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Definition",
                "@type": [
                    "http://www.w3.org/2002/07/owl#DatatypeProperty"
                ],
                "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
                    {
                        "@id": "http://www.w3.org/2002/07/owl#topDataProperty"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#domain": [
                    {
                        "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Type_Description"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@value": "Description:\nA textual definition of the data element\n\nLiability: Necessary\n\nDIN EN 61360-1:2018 Section 8.3\n\nType: String\n\nPoposed Data Range Expression: xsd:string"
                    }
                ]
            },
            {
                "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Drawing_Reference",
                "@type": [
                    "http://www.w3.org/2002/07/owl#DatatypeProperty"
                ],
                "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
                    {
                        "@id": "http://www.w3.org/2002/07/owl#topDataProperty"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#domain": [
                    {
                        "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Type_Description"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@value": "Description:\nA link to a drawing (or picture) that is used for further explanation of the data element\n\nLiability: Optional\n\nDIN EN 61360-1:2018 Section 6.13\n\nType: Contains a URL link as a string to a picture\n\nPoposed Data Range Expression: xsd:string"
                    }
                ]
            },
            {
                "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Format_DIN61360_SemAnz40",
                "@type": [
                    "http://www.w3.org/2002/07/owl#DatatypeProperty"
                ],
                "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
                    {
                        "@id": "http://www.w3.org/2002/07/owl#topDataProperty"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#domain": [
                    {
                        "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Data_Element"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@value": "Description: \n\nIndicates, whether the described type or entity is described by the DIN61360&SemAnz40 Format.\n\nLiability: Necessary\n\nType: If true, the Data Element is based on the Din61360 and SemAnz40 description\n\nPoposed Data Range Expression: xsd:boolean"
                    }
                ]
            },
            {
                "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Formula",
                "@type": [
                    "http://www.w3.org/2002/07/owl#DatatypeProperty"
                ],
                "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
                    {
                        "@id": "http://www.w3.org/2002/07/owl#topDataProperty"
                    }
                ],
