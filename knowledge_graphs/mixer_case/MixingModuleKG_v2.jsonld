                    {
                        "@language": "en",
                        "@value": "State Machine"
                    }
                ]
            },
            {
                "@id": "http://www.hsu-ifa.de/ontologies/UMLStateMachine#containsState",
                "@type": [
                    "http://www.w3.org/2002/07/owl#ObjectProperty"
                ],
                "http://www.w3.org/2000/01/rdf-schema#domain": [
                    {
                        "@id": "http://www.hsu-ifa.de/ontologies/UMLStateMachine#StateMachine"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#range": [
                    {
                        "@id": "http://www.hsu-ifa.de/ontologies/UMLStateMachine#State"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Associates a StateMachine with its States."
                    }
                ]
            },
            {
                "@id": "http://example.org/mixer#stateGraphRoot",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/UMLStateMachine#State"
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@value": "StateGraphRoot"
                    }
                ]
            },
            {
                "@id": "http://www.hsu-ifa.de/ontologies/UMLStateMachine#containsTransition",
                "@type": [
                    "http://www.w3.org/2002/07/owl#ObjectProperty"
                ],
                "http://www.w3.org/2000/01/rdf-schema#domain": [
                    {
                        "@id": "http://www.hsu-ifa.de/ontologies/UMLStateMachine#StateMachine"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#range": [
                    {
                        "@id": "http://www.hsu-ifa.de/ontologies/UMLStateMachine#Transition"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Associates a StateMachine with its Transitions."
                    }
                ]
            },
            {
                "@id": "http://example.org/mixer#condition_init_step",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/UMLStateMachine#Transition"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "\nInitialization transition to begin the mixing process.\nTarget: First filling state (tank B201).\nThis transition is always taken at process start, independent of system conditions.\n    "
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@value": "condition_init_step"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/UMLStateMachine#sourceState": [
                    {
                        "@id": "http://example.org/mixer#state_initialStep"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/UMLStateMachine#targetState": [
                    {
                        "@id": "http://example.org/mixer#state_filling_tank_B201"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/UMLStateMachine#transitionEvent": [
                    {
                        "@id": "http://example.org/mixer#e_init_step"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/UMLStateMachine#transitionGuard": [
                    {
                        "@value": "true"
                    }
                ]
            },
            {
                "@id": "http://example.org/mixer#condition_is_full_tank_B201",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/UMLStateMachine#Transition"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "\nFilling phase transition from tank B201 to B202.\nTrigger: Tank B201 has reached maximum level.\nFilling operations use inlet valves only - no pumps are involved.\nTherefore, pump status does not affect this transition.\n    "
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@value": "condition_is_full_tank_B201"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/UMLStateMachine#sourceState": [
                    {
                        "@id": "http://example.org/mixer#state_filling_tank_B201"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/UMLStateMachine#targetState": [
                    {
                        "@id": "http://example.org/mixer#state_filling_tank_B202"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/UMLStateMachine#transitionEvent": [
                    {
                        "@id": "http://example.org/mixer#e_full_B201"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/UMLStateMachine#transitionGuard": [
                    {
                        "@value": "level >= 0.198 m"
                    }
                ]
            },
            {
                "@id": "http://example.org/mixer#condition_is_empty_tank_B201",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/UMLStateMachine#Transition"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "\nNormal emptying path: Continue from B201 to B202.\nTrigger: Tank B201 has reached minimum level (empty).\nThis transition continues the normal emptying sequence using main pump P101.\nFluid is transferred to collection tank B204 via the main pump line.\n    "
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@value": "condition_is_empty_tank_B201"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/UMLStateMachine#sourceState": [
                    {
                        "@id": "http://example.org/mixer#state_emptying_tank_B201"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/UMLStateMachine#targetState": [
                    {
                        "@id": "http://example.org/mixer#state_emptying_tank_B202"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/UMLStateMachine#transitionEvent": [
                    {
                        "@id": "http://example.org/mixer#e_empty_B201"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/UMLStateMachine#transitionGuard": [
                    {
                        "@value": "level <= 0.022 m"
                    }
                ]
            },
            {
                "@id": "http://example.org/mixer#condition_is_full_tank_B202",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/UMLStateMachine#Transition"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "\nFilling phase transition from tank B202 to B203.\nTrigger: Tank B202 has reached maximum level.\nFilling operations use inlet valves only - no pumps are involved.\nTherefore, pump status does not affect this transition.\n    "
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@value": "condition_is_full_tank_B202"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/UMLStateMachine#sourceState": [
                    {
                        "@id": "http://example.org/mixer#state_filling_tank_B202"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/UMLStateMachine#targetState": [
                    {
                        "@id": "http://example.org/mixer#state_filling_tank_B203"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/UMLStateMachine#transitionEvent": [
                    {
                        "@id": "http://example.org/mixer#e_full_B202"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/UMLStateMachine#transitionGuard": [
                    {
                        "@value": "level >= 0.198 m"
                    }
                ]
            },
            {
                "@id": "http://example.org/mixer#condition_is_empty_tank_B202",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/UMLStateMachine#Transition"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "\nNormal emptying path: Continue from B202 to B203.\nTrigger: Tank B202 has reached minimum level (empty).\nThis transition continues the normal emptying sequence using main pump P101.\n    "
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@value": "condition_is_empty_tank_B202"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/UMLStateMachine#sourceState": [
                    {
                        "@id": "http://example.org/mixer#state_emptying_tank_B202"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/UMLStateMachine#targetState": [
                    {
                        "@id": "http://example.org/mixer#state_emptying_tank_B203"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/UMLStateMachine#transitionEvent": [
                    {
                        "@id": "http://example.org/mixer#e_empty_B202"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/UMLStateMachine#transitionGuard": [
                    {
                        "@value": "level <= 0.022 m"
                    }
                ]
            },
            {
                "@id": "http://example.org/mixer#condition_is_full_tank_B203",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/UMLStateMachine#Transition"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "\nTransition to NORMAL emptying path.\nTrigger: Tank B203 has reached maximum level.\nTarget: Begin emptying sequence using main pump P101.\n\nOPERATIONAL REQUIREMENTS:\n- Main pump P101 must be operational\n- Flow path through P101 must be clear and unobstructed, no clogging or leakage\n- P101 must be capable of providing sufficient flow rate\n\nIf these requirements cannot be met, the alternative bypass path \n(condition_bypass_fault) should be used instead.\n    "
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@value": "condition_is_full_tank_B203"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/UMLStateMachine#sourceState": [
                    {
                        "@id": "http://example.org/mixer#state_filling_tank_B203"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/UMLStateMachine#targetState": [
                    {
                        "@id": "http://example.org/mixer#state_emptying_tank_B201"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/UMLStateMachine#transitionEvent": [
                    {
                        "@id": "http://example.org/mixer#e_full_B203"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/UMLStateMachine#transitionGuard": [
                    {
                        "@value": "level >= 0.198 m"
                    }
                ]
            },
            {
                "@id": "http://example.org/mixer#condition_is_empty_tank_B203",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/UMLStateMachine#Transition"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "\nEmptying path: Transition to final drain phase.\nTrigger: Tank B203 has reached minimum level (empty).\nTarget: Final drain state for collection tank B204.\nAll inlet tanks are now empty. The collected fluid in B204 must be drained.\nNote: Final drain uses gravity through valve_out_B204 - no pump required.\n    "
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@value": "condition_is_empty_tank_B203"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/UMLStateMachine#sourceState": [
                    {
                        "@id": "http://example.org/mixer#state_emptying_tank_B203"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/UMLStateMachine#targetState": [
                    {
                        "@id": "http://example.org/mixer#state_emptying_tank_B204"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/UMLStateMachine#transitionEvent": [
                    {
                        "@id": "http://example.org/mixer#e_empty_B203"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/UMLStateMachine#transitionGuard": [
                    {
                        "@value": "level <= 0.022 m"
                    }
                ]
            },
            {
                "@id": "http://example.org/mixer#condition_is_empty_tank_B204",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/UMLStateMachine#Transition"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "\nProcess completion transition.\nTrigger: Collection tank B204 has reached minimum level (empty).\nThe entire mixing cycle is complete. All tanks are empty.\nSystem returns to initial state, ready for next batch.\n    "
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@value": "condition_is_empty_tank_B204"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/UMLStateMachine#sourceState": [
                    {
                        "@id": "http://example.org/mixer#state_emptying_tank_B204"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/UMLStateMachine#targetState": [
                    {
                        "@id": "http://example.org/mixer#state_initialStep"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/UMLStateMachine#transitionEvent": [
                    {
                        "@id": "http://example.org/mixer#e_empty_B204"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/UMLStateMachine#transitionGuard": [
                    {
                        "@value": "level <= 0.122 m"
                    }
                ]
            },
            {
                "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Unit_of_Measure",
