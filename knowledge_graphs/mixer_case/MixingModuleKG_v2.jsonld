                        "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#has_Data_Element"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@value": "Description:\nThis ObjectProperty is used to connect a data element with any kind of entity that is described by the data element"
