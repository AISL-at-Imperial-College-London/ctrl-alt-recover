            {
                "@id": "http://www.hsu-ifa.de/ontologies/UMLStateMachine#StateMachine",
                "@type": [
                    "http://www.w3.org/2002/07/owl#Class"
                ],
                "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
                    {
                        "@id": "http://www.w3id.org/hsu-aut/VDI2206#MathematicalModel"
                    }
                ],
