                        "@id": "_:genid-a980084a203a495f9048ababc1c700d721566-b58"
                    },
                    {
                        "@id": "_:genid-a980084a203a495f9048ababc1c700d721566-b59"
                    }
                ]
            },
            {
                "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#complex_Data_Type_has_Member",
                "@type": [
                    "http://www.w3.org/2002/07/owl#ObjectProperty"
                ],
                "http://www.w3.org/2000/01/rdf-schema#domain": [
                    {
                        "@id": "_:genid-a980084a203a495f9048ababc1c700d721566-b56"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#range": [
                    {
                        "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Complex_Data_Type_Member"
                    }
                ],
                "http://www.w3.org/2002/07/owl#inverseOf": [
                    {
                        "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#is_Member_of_Complex_Data_Type"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@value": "Description:\nObjectProperty that is used to connect an instance of a complex data type with corresponding members of the complex data type. These members are connected to types and instances of other (complex) data types"
                    }
                ]
            },
            {
                "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Bag_Member",
                "@type": [
                    "http://www.w3.org/2002/07/owl#Class"
                ],
                "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
                    {
                        "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Complex_Data_Type_Member"
                    }
                ]
            },
            {
