                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@value": "Description:\nA link to a drawing (or picture) that is used for further explanation of the data element\n\nLiability: Optional\n\nDIN EN 61360-1:2018 Section 6.13\n\nType: Contains a URL link as a string to a picture\n\nPoposed Data Range Expression: xsd:string"
                    }
                ]
            },
            {
                "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Format_DIN61360_SemAnz40",
                "@type": [
                    "http://www.w3.org/2002/07/owl#DatatypeProperty"
                ],
                "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
                    {
                        "@id": "http://www.w3.org/2002/07/owl#topDataProperty"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#domain": [
                    {
                        "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Data_Element"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@value": "Description: \n\nIndicates, whether the described type or entity is described by the DIN61360&SemAnz40 Format.\n\nLiability: Necessary\n\nType: If true, the Data Element is based on the Din61360 and SemAnz40 description\n\nPoposed Data Range Expression: xsd:boolean"
                    }
                ]
            },
            {
                "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Formula",
                "@type": [
                    "http://www.w3.org/2002/07/owl#DatatypeProperty"
                ],
                "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
                    {
                        "@id": "http://www.w3.org/2002/07/owl#topDataProperty"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#domain": [
                    {
                        "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Type_Description"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@value": "Description:\nA mathematical euqation that is being used for characterization of the data element\n\nLiability: Optional\n\nDIN EN 61360-1:2018 Section 6.5\n\nType: contains a URL link as a string to a source file that describes the formula\n\nPoposed Data Range Expression: xsd:string"
                    }
                ]
            },
            {
                "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Type_Description_has_Instance",
