                "@type": [
                    "http://www.hsu-ifa.de/ontologies/UMLStateMachine#State"
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@value": "bypass emptying tank B203"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/UMLStateMachine#doAction": [
                    {
                        "@id": "http://example.org/mixer#act_valve_pump_B203_on"
                    },
