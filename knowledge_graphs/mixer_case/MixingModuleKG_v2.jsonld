            {
                "@id": "http://www.w3id.org/hsu-aut/VDI3682#hasSubProcess",
                "@type": [
                    "http://www.w3.org/2002/07/owl#TransitiveProperty",
                    "http://www.w3.org/2002/07/owl#ObjectProperty"
                ],
                "http://www.w3.org/2000/01/rdf-schema#domain": [
                    {
                        "@id": "_:genid-a980084a203a495f9048ababc1c700d721566-b77"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#range": [
                    {
                        "@id": "http://www.w3id.org/hsu-aut/VDI3682#Process"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@value": "Is used to find the complete decomposed process of a process operatore. Note: This is syntactic sugar as a subprocess can be found by following \"isComposedOf\" and the inverse of \"consistsOf\"."
                    }
                ],
                "http://www.w3.org/2002/07/owl#propertyChainAxiom": [
                    {
                        "@list": [
                            {
                                "@id": "http://www.w3id.org/hsu-aut/VDI3682#isComposedOf"
                            },
                            {
