                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@value": "Description:\nDIN EN 61360-1:2018 Section 7.3\nUnique identifier of this data element type. Preferable this should be a standardized identifier (e.g. from eclss or common data dictionary).  optional exlusion of \"o\" and \"i\" is not implemented.    \n\nLiability: necessary    \n\ntype: string with 6 digits between, first three digits are a-z and last three digits are 0-9  poposed data range expression: xsd:string[pattern \"[a-z0-9] {6}\"]"
                    }
                ]
            },
            {
                "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Definition",
                "@type": [
                    "http://www.w3.org/2002/07/owl#DatatypeProperty"
                ],
                "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
                    {
                        "@id": "http://www.w3.org/2002/07/owl#topDataProperty"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#domain": [
                    {
                        "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Type_Description"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@value": "Description:\nA textual definition of the data element\n\nLiability: Necessary\n\nDIN EN 61360-1:2018 Section 8.3\n\nType: String\n\nPoposed Data Range Expression: xsd:string"
                    }
                ]
            },
            {
                "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Preferred_Name",
                "@type": [
                    "http://www.w3.org/2002/07/owl#DatatypeProperty"
                ],
                "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
                    {
                        "@id": "http://www.w3.org/2002/07/owl#topDataProperty"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#domain": [
                    {
                        "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Type_Description"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@value": "Description:\nRepresents the preferred name of the data element type, that is being used for searches for instance.\n\nLiability: Necessary\n\nDIN EN 61360-1:2018 Section 7.4\n\nType: String with lower and upper case, with a maximum of 70 characters\n\nPoposed Data Range Expression: xsd:string[maxLength 70]"
                    }
                ]
            },
            {
                "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Short_Name",
                "@type": [
                    "http://www.w3.org/2002/07/owl#DatatypeProperty"
                ],
                "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
                    {
                        "@id": "http://www.w3.org/2002/07/owl#topDataProperty"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#domain": [
                    {
                        "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Type_Description"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@value": "Description:\nA short name or acronym that is used for the preferred name\n\nLiability: Necessary\n\nDIN EN 61360-1:2018 Section 7.6\n\nType: Strong restrictions of DIN61360  not implemented, just strings necessary. Maximum characters is 17.\n\nPoposed Data Range Expression: xsd:string[maxLength 17]"
                    }
                ]
            },
            {
                "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Version_Number",
                "@type": [
                    "http://www.w3.org/2002/07/owl#DatatypeProperty"
                ],
                "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
                    {
                        "@id": "http://www.w3.org/2002/07/owl#topDataProperty"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#domain": [
                    {
                        "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Type_Description"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@value": "Description:\nNumber that indicates different versions of one data element type\n\nLiability: Necessary\n\nDIN EN 61360-1:2018 Section 7.8\n\nType: Integer with three digits max, so between 1 and 999\n\nPoposed Data Range Expression: xsd:integer[>= 1 , <= 999]"
                    }
                ]
            },
            {
                "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Preferred_Letter_Symbol",
                "@type": [
                    "http://www.w3.org/2002/07/owl#DatatypeProperty"
                ],
                "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
                    {
                        "@id": "http://www.w3.org/2002/07/owl#topDataProperty"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#domain": [
                    {
                        "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Type_Description"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@value": "Description:\nA sign or literal that is used to represent the property (e.g. greek \"sigma\" for tension))\n\nLiability: Optional\n\nDIN EN 61360-1:2018 Section 6.6\n\nType: IEC 60027, IEC 60747 or IEC 60148 compliant formula sign described as a string\n\nPoposed Data Range Expression: xsd:string"
                    }
                ]
            },
            {
                "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Synonymous_Letter_Symbol",
                "@type": [
                    "http://www.w3.org/2002/07/owl#DatatypeProperty"
                ],
                "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
                    {
                        "@id": "http://www.w3.org/2002/07/owl#topDataProperty"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#domain": [
                    {
                        "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Type_Description"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@value": "Description:\nA synonym that is used for the preferred equation sign\n\nLiability: Optional\n\nDIN EN 61360-1:2018 Section 6.7\n\nType: IEC 60027, IEC 60747 or IEC 60148 compliant formula sign\n\nPoposed Data Range Expression: xsd:string"
                    }
                ]
            },
            {
                "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Synonymous_Name",
                "@type": [
                    "http://www.w3.org/2002/07/owl#DatatypeProperty"
                ],
                "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
                    {
                        "@id": "http://www.w3.org/2002/07/owl#topDataProperty"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#domain": [
                    {
                        "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Type_Description"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@value": "Description:\nSynonyms to the preferred name\n\nLiability: Optional\n\nDIN EN 61360-1:2018 Section 7.7\n\nType: String with lower and upper case, with a maximum of 70 characters\n\nPoposed Data Range Expression: xsd:string[maxLength 70]"
                    }
                ]
            },
            {
                "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Logic_Interpretation",
                "@type": [
                    "http://www.w3.org/2002/07/owl#DatatypeProperty",
                    "http://www.w3.org/2002/07/owl#FunctionalProperty"
                ],
                "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
                    {
                        "@id": "http://www.w3.org/2002/07/owl#topDataProperty"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#domain": [
                    {
                        "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Instance_Description"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#range": [
                    {
                        "@id": "_:genid-a980084a203a495f9048ababc1c700d721566-b62"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@value": "Description:\n\nIndicates, whether a value with a certain Expression Goal has to be considered as equal (\"=\"), greater than (\"<\"), lower than (\">\") or in combination with an equals (i.e. \"<=\", \">=\").\n\nLiability: Necessary"
                    }
                ]
            },
            {
                "@id": "http://www.hsu-ifa.de/ontologies/UMLStateMachine#State",
                "@type": [
                    "http://www.w3.org/2002/07/owl#Class"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "A distinct condition or situation of the system."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "State"
                    }
                ]
            },
            {
                "@id": "http://www.hsu-ifa.de/ontologies/UMLStateMachine#Transition",
                "@type": [
                    "http://www.w3.org/2002/07/owl#Class"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Change from one State to another, possibly triggered by an Event."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "Transition"
                    }
                ]
            },
            {
                "@id": "http://www.hsu-ifa.de/ontologies/UMLStateMachine#Event",
                "@type": [
                    "http://www.w3.org/2002/07/owl#Class"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "Occurrence that may trigger a Transition."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "Event"
                    }
                ]
            },
            {
                "@id": "http://www.hsu-ifa.de/ontologies/UMLStateMachine#Action",
                "@type": [
                    "http://www.w3.org/2002/07/owl#Class"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "An operation executed on entry, during, or exit of a State, or as effect of a Transition."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@language": "en",
                        "@value": "Action"
                    }
                ]
            },
            {
                "@id": "http://www.w3id.org/hsu-aut/VDI2206#Actuator",
                "@type": [
                    "http://www.w3.org/2002/07/owl#Class"
                ],
                "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
                    {
                        "@id": "http://www.w3id.org/hsu-aut/VDI2206#Component"
                    }
                ],
                "http://www.w3.org/2002/07/owl#equivalentClass": [
                    {
                        "@id": "http://www.w3.org/ns/sosa/Actuator"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@value": "The information processing determines the effects necessary to influence the state variables of the basic system in the desired way. The implementation of the effects takes place by actors directly on the basic system."
                    }
                ]
            },
            {
                "@id": "http://www.w3.org/ns/sosa/Actuator",
                "@type": [
                    "http://www.w3.org/2002/07/owl#Class"
                ],
                "http://www.w3.org/2002/07/owl#equivalentClass": [
                    {
                        "@id": "http://www.w3id.org/hsu-aut/VDI2206#Actuator"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@value": "A device responsible for performing actuations on properties."
                    },
                    {
                        "@language": "en",
                        "@value": "\n            Equate SOSA Actuator with VDI2206:Actuator\n        "
                    }
                ]
            },
            {
                "@id": "http://www.w3id.org/hsu-aut/VDI2206#Sensor",
                "@type": [
                    "http://www.w3.org/2002/07/owl#Class"
                ],
                "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
                    {
                        "@id": "http://www.w3id.org/hsu-aut/VDI2206#Component"
                    }
                ],
                "http://www.w3.org/2002/07/owl#equivalentClass": [
                    {
                        "@id": "http://www.w3.org/ns/sosa/Sensor"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@value": "The task of the sensors is to determine selected state variables of the basic system."
                    }
                ]
            },
            {
                "@id": "http://www.w3.org/ns/sosa/Sensor",
                "@type": [
                    "http://www.w3.org/2002/07/owl#Class"
                ],
                "http://www.w3.org/2002/07/owl#equivalentClass": [
                    {
                        "@id": "http://www.w3id.org/hsu-aut/VDI2206#Sensor"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@value": "A device, agent or software that performs observations."
                    },
                    {
                        "@language": "en",
                        "@value": "\n            Equate SOSA Sensor with VDI2206:Sensor\n        "
                    }
                ]
            },
            {
                "@id": "http://www.w3id.org/hsu-aut/VDI3682#TechnicalResource",
                "@type": [
                    "http://www.w3.org/2002/07/owl#Class"
                ],
                "http://www.w3.org/2002/07/owl#equivalentClass": [
                    {
                        "@id": "http://www.w3id.org/hsu-aut/VDI3682#BasicSystem"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@value": "The technical resource is able to implement certain processes and is an abstract description of a system.\n[VDI 3682-1]"
                    }
                ]
            },
            {
                "@id": "http://www.w3id.org/hsu-aut/VDI3682#State",
                "@type": [
                    "http://www.w3.org/2002/07/owl#Class"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@value": "A State describes the actual state of a Product/Energy/Information. Exp.: status ante operationem and status post operationem.\n[VDI3682-1]"
                    },
                    {
                        "@value": "A State describes the actual state of a Product/Energy/Information. Exp.: status after process operator execution and status before.\n[VDI3682-1]"
                    }
                ],
                "http://www.w3.org/2002/07/owl#disjointWith": [
                    {
                        "@id": "http://www.w3id.org/hsu-aut/VDI3682#TechnicalResource"
                    },
                    {
                        "@id": "http://www.w3id.org/hsu-aut/VDI3682#SystemLimit"
                    }
                ]
            },
            {
                "@id": "http://www.w3id.org/hsu-aut/VDI3682#SystemLimit",
                "@type": [
                    "http://www.w3.org/2002/07/owl#Class"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@value": "The system limit determines the observation horizon of the process. In a broader sense, this can also be seen as the balance limit for incoming products/energy/information and outgoing products/energy/information.\n[VDI 3682-1]"
                    }
                ],
                "http://www.w3.org/2002/07/owl#disjointWith": [
                    {
                        "@id": "http://www.w3id.org/hsu-aut/VDI3682#TechnicalResource"
                    }
                ]
            },
            {
                "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Complex_Data_Type_Member",
                "@type": [
                    "http://www.w3.org/2002/07/owl#Class"
                ],
                "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
