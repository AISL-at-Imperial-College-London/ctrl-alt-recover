            },
            {
                "@id": "http://example.org/mixer#condition_bypass_fault",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/UMLStateMachine#Transition"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@value": "Bypass must be activated: normal emptying path B201/B202/B203 → B204 is faulty due to pipes and pump P204 being defective."
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@value": "condition_bypass_fault"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/UMLStateMachine#sourceState": [
                    {
                        "@id": "http://example.org/mixer#state_filling_tank_B203"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/UMLStateMachine#targetState": [
                    {
                        "@id": "http://example.org/mixer#state_bypass_emptying_tank_b201"
                    }
                ]
            },
            {
                "@id": "http://example.org/mixer#condition_bypass_empty_B201",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/UMLStateMachine#Transition"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "\nBypass emptying path: Continue from B201 to B202.\nTrigger: Tank B201 has reached minimum level (empty).\nThis transition continues the bypass emptying sequence using backup pump P102.\nFluid is transferred to collection tank B204 via the backup pump line.\n    "
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@value": "condition_bypass_empty_B201"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/UMLStateMachine#sourceState": [
                    {
                        "@id": "http://example.org/mixer#state_bypass_emptying_tank_b201"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/UMLStateMachine#targetState": [
                    {
                        "@id": "http://example.org/mixer#state_bypass_emptying_tank_b202"
                    }
                ]
            },
            {
                "@id": "http://example.org/mixer#condition_bypass_empty_B202",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/UMLStateMachine#Transition"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@language": "en",
                        "@value": "\nBypass emptying path: Continue from B202 to B203.\nTrigger: Tank B202 has reached minimum level (empty).\nThis transition continues the bypass emptying sequence using backup pump P102.\n    "
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@value": "condition_bypass_empty_B202"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/UMLStateMachine#sourceState": [
                    {
                        "@id": "http://example.org/mixer#state_bypass_emptying_tank_b202"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/UMLStateMachine#targetState": [
                    {
                        "@id": "http://example.org/mixer#state_bypass_emptying_tank_b203"
                    }
                ]
            },
            {
                "@id": "http://example.org/mixer#condition_bypass_empty_B203",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/UMLStateMachine#Transition"
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@value": "\nBypass emptying path: Transition to final drain phase.\nTrigger: Tank B203 has reached minimum level (empty).\n\nAfter B203 is empty, all three inlet tanks (B201, B202, B203) have been drained \nvia the bypass path. The fluid is now collected in tank B204.\n\nTank B204 is the collection tank - it receives fluid from the inlet tanks and \ndrains by gravity through valve_out_B204. No pump is required for B204 drainage,\ntherefore the bypass path ends here and B204 is emptied identically to the \nfault-free process.\n"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@value": "condition_bypass_empty_B203"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/UMLStateMachine#sourceState": [
                    {
                        "@id": "http://example.org/mixer#state_bypass_emptying_tank_b203"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/UMLStateMachine#targetState": [
                    {
                        "@id": "http://example.org/mixer#state_emptying_tank_B204"
                    }
                ]
            },
            {
                "@id": "http://example.org/mixer#act_set_pump_speed_P102",
                "@type": [
                    "http://www.hsu-ifa.de/ontologies/UMLStateMachine#Action"
                ],
                "http://www.w3.org/2000/01/rdf-schema#label": [
                    {
                        "@value": "set bypass pump P102 speed"
                    }
                ],
                "http://www.hsu-ifa.de/ontologies/CPSMod#isChangedByActuator": [
