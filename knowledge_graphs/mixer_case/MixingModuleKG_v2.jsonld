                    {
                        "@id": "_:genid-a980084a203a495f9048ababc1c700d721566-b55"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#range": [
                    {
                        "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Type_Description"
                    }
                ],
                "http://www.w3.org/2002/07/owl#inverseOf": [
                    {
                        "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#is_Type_Description_of_Data_Element"
                    }
                ],
                "http://www.w3.org/2000/01/rdf-schema#comment": [
                    {
                        "@value": "Description:\nObjectProperty is used to connect an individual that needs to be described by DataProperties with the Type Description of that properties.\n\nFunctional:\nAny indivudual representing a property, can have only one Type Description"
                    }
                ]
            },
            {
                "@id": "http://www.hsu-ifa.de/ontologies/DINEN61360#Type_Description",
