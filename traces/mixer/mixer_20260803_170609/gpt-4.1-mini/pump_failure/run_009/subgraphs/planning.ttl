@prefix : <http://example.org/mixer#> .
@prefix UML: <http://www.hsu-ifa.de/ontologies/UMLStateMachine#> .
@prefix VDI2206: <http://www.w3id.org/hsu-aut/VDI2206#> .
@prefix VDI3682: <http://www.w3id.org/hsu-aut/VDI3682#> .
@prefix CPSMod: <http://www.hsu-ifa.de/ontologies/CPSMod#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf4j: <http://rdf4j.org/schema/rdf4j#> .
@prefix sesame: <http://www.openrdf.org/schema/sesame#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix fn: <http://www.w3.org/2005/xpath-functions#> .

:mixerModule1234 a VDI2206:Module;
  rdfs:label "Mixer Module" .

:mixing1234 a VDI3682:ProcessOperator;
  VDI3682:isAssignedto :mixerModule1234;
  CPSMod:processRealizesBehavior :MixerStateMachine .

:MixerStateMachine a UML:StateMachine;
  rdfs:label "mixerModule StateGraph describing the behavior of the Modva mixing Module process plant" .

:state_initialStep a UML:State .

:state_filling_tank_B201 a UML:State;
  UML:doAction :act_open_valve_in0 .

:condition_init_step a UML:Transition;
  UML:sourceState :state_initialStep;
  UML:targetState :state_filling_tank_B201;
  UML:transitionEvent :e_init_step;
  UML:transitionGuard "true";
  rdfs:label "condition_init_step";
  rdfs:comment """
Initialization transition to begin the mixing process.
Target: First filling state (tank B201).
This transition is always taken at process start, independent of system conditions.
    """@en .

:e_init_step a UML:Event .

:state_filling_tank_B202 a UML:State;
  UML:doAction :act_open_valve_in1 .

:condition_is_full_tank_B201 a UML:Transition;
  UML:sourceState :state_filling_tank_B201;
  UML:targetState :state_filling_tank_B202;
  UML:transitionEvent :e_full_B201;
  UML:transitionGuard "level >= 0.198 m";
  rdfs:label "condition_is_full_tank_B201";
  rdfs:comment """
Filling phase transition from tank B201 to B202.
Trigger: Tank B201 has reached maximum level.
Filling operations use inlet valves only - no pumps are involved.
Therefore, pump status does not affect this transition.
    """@en .

:e_full_B201 a UML:Event .

:act_open_valve_in0 a UML:Action;
  rdfs:label "open valve_in0" .

:state_emptying_tank_B204 a UML:State;
  UML:doAction :act_open_valve_out .

:condition_is_empty_tank_B204 a UML:Transition;
  UML:sourceState :state_emptying_tank_B204;
  UML:targetState :state_initialStep;
  UML:transitionEvent :e_empty_B204;
  UML:transitionGuard "level <= 0.122 m";
  rdfs:label "condition_is_empty_tank_B204";
  rdfs:comment """
Process completion transition.
Trigger: Collection tank B204 has reached minimum level (empty).
The entire mixing cycle is complete. All tanks are empty.
System returns to initial state, ready for next batch.
    """@en .

:e_empty_B204 a UML:Event .

:act_open_valve_out a UML:Action;
  rdfs:label "open valve_out" .

:state_filling_tank_B203 a UML:State;
  UML:doAction :act_open_valve_in2 .

:condition_is_full_tank_B202 a UML:Transition;
  UML:sourceState :state_filling_tank_B202;
  UML:targetState :state_filling_tank_B203;
  UML:transitionEvent :e_full_B202;
  UML:transitionGuard "level >= 0.198 m";
  rdfs:label "condition_is_full_tank_B202";
  rdfs:comment """
Filling phase transition from tank B202 to B203.
Trigger: Tank B202 has reached maximum level.
Filling operations use inlet valves only - no pumps are involved.
Therefore, pump status does not affect this transition.
    """@en .

:e_full_B202 a UML:Event .

:act_open_valve_in1 a UML:Action;
  rdfs:label "open valve_in1" .

:state_emptying_tank_B203 a UML:State;
  UML:doAction :act_set_pump_speed, :act_valve_pump_B203_on, :act_valve_pump_B204_on .

:condition_is_empty_tank_B203 a UML:Transition;
  UML:sourceState :state_emptying_tank_B203;
  UML:targetState :state_emptying_tank_B204;
  UML:transitionEvent :e_empty_B203;
  UML:transitionGuard "level <= 0.022 m";
  rdfs:label "condition_is_empty_tank_B203";
  rdfs:comment """
Emptying path: Transition to final drain phase.
Trigger: Tank B203 has reached minimum level (empty).
Target: Final drain state for collection tank B204.
All inlet tanks are now empty. The collected fluid in B204 must be drained.
Note: Final drain uses gravity through valve_out_B204 - no pump required.
    """@en .

:e_empty_B203 a UML:Event .

:act_set_pump_speed a UML:Action;
  rdfs:label "set pump_P101 speed" .

:act_valve_pump_B203_on a UML:Action;
  rdfs:label "open valve_pump_tank_B203" .

:act_valve_pump_B204_on a UML:Action;
  rdfs:label "open valve_pump_tank_B204" .

:state_bypass_emptying_tank_b203 a UML:State;
  rdfs:label "bypass emptying tank B203";
  UML:doAction :act_valve_pump_B203_on, :act_valve_pump_B204_on, :act_set_pump_speed_P102 .

:condition_bypass_empty_B203 a UML:Transition;
  UML:sourceState :state_bypass_emptying_tank_b203;
  UML:targetState :state_emptying_tank_B204;
  rdfs:label "condition_bypass_empty_B203";
  rdfs:comment """
Bypass emptying path: Transition to final drain phase.
Trigger: Tank B203 has reached minimum level (empty).

After B203 is empty, all three inlet tanks (B201, B202, B203) have been drained 
via the bypass path. The fluid is now collected in tank B204.

Tank B204 is the collection tank - it receives fluid from the inlet tanks and 
drains by gravity through valve_out_B204. No pump is required for B204 drainage,
therefore the bypass path ends here and B204 is emptied identically to the 
fault-free process.
""" .

:act_set_pump_speed_P102 a UML:Action;
  rdfs:label "set bypass pump P102 speed" .

:state_emptying_tank_B201 a UML:State;
  UML:doAction :act_set_pump_speed, :act_valve_pump_B201_on, :act_valve_pump_B204_on .

:condition_is_full_tank_B203 a UML:Transition;
  UML:sourceState :state_filling_tank_B203;
  UML:targetState :state_emptying_tank_B201;
  UML:transitionEvent :e_full_B203;
  UML:transitionGuard "level >= 0.198 m";
  rdfs:label "condition_is_full_tank_B203";
  rdfs:comment """
Transition to NORMAL emptying path.
Trigger: Tank B203 has reached maximum level.
Target: Begin emptying sequence using main pump P101.

OPERATIONAL REQUIREMENTS:
- Main pump P101 must be operational
- Flow path through P101 must be clear and unobstructed, no clogging or leakage
- P101 must be capable of providing sufficient flow rate

If these requirements cannot be met, the alternative bypass path 
(condition_bypass_fault) should be used instead.
    """@en .

:e_full_B203 a UML:Event .

:act_open_valve_in2 a UML:Action;
  rdfs:label "open valve_in2" .

:state_bypass_emptying_tank_b201 a UML:State;
  rdfs:label "bypass emptying tank B201";
  UML:doAction :act_valve_pump_B201_on, :act_valve_pump_B204_on, :act_set_pump_speed_P102 .

:condition_bypass_fault a UML:Transition;
  UML:sourceState :state_filling_tank_B203;
  UML:targetState :state_bypass_emptying_tank_b201;
  rdfs:label "condition_bypass_fault";
  rdfs:comment "Bypass must be activated: normal emptying path B201/B202/B203 → B204 is faulty due to pipes and pump P204 being defective." .

:state_emptying_tank_B202 a UML:State;
  UML:doAction :act_set_pump_speed, :act_valve_pump_B202_on, :act_valve_pump_B204_on .

:condition_is_empty_tank_B202 a UML:Transition;
  UML:sourceState :state_emptying_tank_B202;
  UML:targetState :state_emptying_tank_B203;
  UML:transitionEvent :e_empty_B202;
  UML:transitionGuard "level <= 0.022 m";
  rdfs:label "condition_is_empty_tank_B202";
  rdfs:comment """
Normal emptying path: Continue from B202 to B203.
Trigger: Tank B202 has reached minimum level (empty).
This transition continues the normal emptying sequence using main pump P101.
    """@en .

:e_empty_B202 a UML:Event .

:act_valve_pump_B202_on a UML:Action;
  rdfs:label "open valve_pump_tank_B202" .

:state_bypass_emptying_tank_b202 a UML:State;
  rdfs:label "bypass emptying tank B202";
  UML:doAction :act_valve_pump_B202_on, :act_valve_pump_B204_on, :act_set_pump_speed_P102 .

:condition_bypass_empty_B202 a UML:Transition;
  UML:sourceState :state_bypass_emptying_tank_b202;
  UML:targetState :state_bypass_emptying_tank_b203;
  rdfs:label "condition_bypass_empty_B202";
  rdfs:comment """
Bypass emptying path: Continue from B202 to B203.
Trigger: Tank B202 has reached minimum level (empty).
This transition continues the bypass emptying sequence using backup pump P102.
    """@en .

:condition_is_empty_tank_B201 a UML:Transition;
  UML:sourceState :state_emptying_tank_B201;
  UML:targetState :state_emptying_tank_B202;
  UML:transitionEvent :e_empty_B201;
  UML:transitionGuard "level <= 0.022 m";
  rdfs:label "condition_is_empty_tank_B201";
  rdfs:comment """
Normal emptying path: Continue from B201 to B202.
Trigger: Tank B201 has reached minimum level (empty).
This transition continues the normal emptying sequence using main pump P101.
Fluid is transferred to collection tank B204 via the main pump line.
    """@en .

:e_empty_B201 a UML:Event .

:act_valve_pump_B201_on a UML:Action;
  rdfs:label "open valve_pump_tank_B201" .

:condition_bypass_empty_B201 a UML:Transition;
  UML:sourceState :state_bypass_emptying_tank_b201;
  UML:targetState :state_bypass_emptying_tank_b202;
  rdfs:label "condition_bypass_empty_B201";
  rdfs:comment """
Bypass emptying path: Continue from B201 to B202.
Trigger: Tank B201 has reached minimum level (empty).
This transition continues the bypass emptying sequence using backup pump P102.
Fluid is transferred to collection tank B204 via the backup pump line.
    """@en .
